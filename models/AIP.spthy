theory AIP
begin

builtins: signing, hashing

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction CaveatPermits:
  "All c a #i. Check(c, a) @ #i ==> (c = a | (Ex op x. a = <op, x> & c = <op, 'any'>))"

restriction ConcreteOperand:
  "All op #i. Act(<op, 'any'>) @ #i ==> F"

restriction UniqueKey:
  "All X #i #j. Register(X) @ #i & Register(X) @ #j ==> #i = #j"

restriction OneValuePerSourceAndTask:
  "All s t v w #i #j. Produced(s, t, v) @ #i & Produced(s, t, w) @ #j ==> #i = #j"

restriction ContextNonEmpty:
  "All x #i. NonEmpty(x) @ #i ==> not (x = 'empty')"

rule Register:
  [ Fr(~k) ]
  --[ Register($X) ]->
  [ !Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k)) ]

#ifdef CAPSULE
rule Human_static_task:
  let c  = <'push', 'any'>
      t  = <'fixed', 'push', $repo>
      b0 = <'b0', $H, $A1, c, ~tid>
      cap = <'cap', $H, ~tid, t>
  in
  [ Fr(~tid), !Ltk($H, kH) ]
  --[ Intends($H, ~tid, t), RootDelegated($H, $A1, c, ~tid), TaskStatic(~tid) ]->
  [ Out(<b0, sign(b0, kH)>), Out(<cap, sign(cap, kH)>) ]
#else
rule Human_static_task:
  let c  = <'push', 'any'>
      t  = <'fixed', 'push', $repo>
      b0 = <'b0', $H, $A1, c, ~tid>
  in
  [ Fr(~tid), !Ltk($H, kH) ]
  --[ Intends($H, ~tid, t), RootDelegated($H, $A1, c, ~tid), TaskStatic(~tid) ]->
  [ Out(<b0, sign(b0, kH)>) ]
#endif

#ifdef CAPSULE
rule Human_dynamic_task:
  let c  = <'push', 'any'>
      t  = <'hole', 'push', $Src>
      b0 = <'b0', $H, $A1, c, ~tid>
      cap = <'cap', $H, ~tid, t>
  in
  [ Fr(~tid), !Ltk($H, kH) ]
  --[ Intends($H, ~tid, t), RootDelegated($H, $A1, c, ~tid), TaskDynamic(~tid) ]->
  [ Out(<b0, sign(b0, kH)>), Out(<cap, sign(cap, kH)>) ]
#else
rule Human_dynamic_task:
  let c  = <'push', 'any'>
      t  = <'hole', 'push', $Src>
      b0 = <'b0', $H, $A1, c, ~tid>
  in
  [ Fr(~tid), !Ltk($H, kH) ]
  --[ Intends($H, ~tid, t), RootDelegated($H, $A1, c, ~tid), TaskDynamic(~tid) ]->
  [ Out(<b0, sign(b0, kH)>) ]
#endif

rule Source_produces:
  let p = <'prov', $Src, tid, $v>
  in
  [ In(tid), !Ltk($Src, ks) ]
  --[ Produced($Src, tid, $v) ]->
  [ Out(<p, sign(p, ks)>) ]

rule Agent1_steered_delegation_block:
  let b0  = <'b0', H, $A1, c1, tid>
      blk = <'blk', $A1, A2, c2, ctx, h(<b0, s0>)>
  in
  [ In(<b0, s0>), In(<A2, c2, ctx>), !Pk(H, pkH), !Ltk($A1, k1) ]
  --[ Eq(verify(s0, b0, pkH), true), Delegated($A1, A2, c2, tid), ContextWritten($A1, tid, ctx) ]->
  [ Out(<blk, sign(blk, k1)>) ]

rule Agent2_steered_call:
  let b0  = <'b0', H, A1, c1, tid>
      blk = <'blk', A1, $A2, c2, ctx, h(<b0, s0>)>
  in
  [ In(<b0, s0, blk, s1>), In(<$M, a>), !Pk(H, pkH), !Pk(A1, pkA1), !Ltk($A2, k2) ]
  --[ Eq(verify(s0, b0, pkH), true), Eq(verify(s1, blk, pkA1), true), Request($A2, a, tid) ]->
  [ Out(<'call', $M, a, b0, s0, blk, s1>) ]

#ifdef not CAPSULE
rule Server_accepts_tool_call:
  let b0  = <'b0', H, A1, c1, tid>
      blk = <'blk', A1, A2, c2, ctx, h(<b0, s0>)>
  in
  [ In(<'call', $M, a, b0, s0, blk, s1>), !Pk(H, pkH), !Pk(A1, pkA1) ]
  --[ Eq(verify(s0, b0, pkH), true), Eq(verify(s1, blk, pkA1), true), NonEmpty(ctx)
    , Check(c1, a), Check(c2, a), Act(a)
    , Accept($M, A2, a, tid), Chain($M, H, A1, c1, A2, c2, tid), AuditContext($M, tid, ctx) ]->
  [ ]
#endif

#ifdef CAPSULE
rule Server_accepts_capsule_fixed:
  let b0  = <'b0', H, A1, c1, tid>
      blk = <'blk', A1, A2, c2, ctx, h(<b0, s0>)>
      cap = <'cap', H, tid, <'fixed', a>>
  in
  [ In(<'call', $M, a, b0, s0, blk, s1>), In(<cap, sc>), !Pk(H, pkH), !Pk(A1, pkA1) ]
  --[ Eq(verify(s0, b0, pkH), true), Eq(verify(s1, blk, pkA1), true), Eq(verify(sc, cap, pkH), true), NonEmpty(ctx)
    , Check(c1, a), Check(c2, a), Act(a)
    , Accept($M, A2, a, tid), Chain($M, H, A1, c1, A2, c2, tid), AuditContext($M, tid, ctx) ]->
  [ ]
#endif

#ifdef CAPSULE & not PROV
rule Server_accepts_capsule_hole_unchecked:
  let b0  = <'b0', H, A1, c1, tid>
      blk = <'blk', A1, A2, c2, ctx, h(<b0, s0>)>
      cap = <'cap', H, tid, <'hole', op, S>>
  in
  [ In(<'call', $M, <op, v>, b0, s0, blk, s1>), In(<cap, sc>), !Pk(H, pkH), !Pk(A1, pkA1) ]
  --[ Eq(verify(s0, b0, pkH), true), Eq(verify(s1, blk, pkA1), true), Eq(verify(sc, cap, pkH), true), NonEmpty(ctx)
    , Check(c1, <op, v>), Check(c2, <op, v>), Act(<op, v>)
    , Accept($M, A2, <op, v>, tid), Chain($M, H, A1, c1, A2, c2, tid), AuditContext($M, tid, ctx) ]->
  [ ]
#endif

#ifdef CAPSULE & PROV
rule Server_accepts_capsule_hole_provenance:
  let b0  = <'b0', H, A1, c1, tid>
      blk = <'blk', A1, A2, c2, ctx, h(<b0, s0>)>
      cap = <'cap', H, tid, <'hole', op, S>>
      p   = <'prov', S, tid, v>
  in
  [ In(<'call', $M, <op, v>, b0, s0, blk, s1>), In(<cap, sc>), In(<p, sp>), !Pk(H, pkH), !Pk(A1, pkA1), !Pk(S, pkS) ]
  --[ Eq(verify(s0, b0, pkH), true), Eq(verify(s1, blk, pkA1), true), Eq(verify(sc, cap, pkH), true), Eq(verify(sp, p, pkS), true), NonEmpty(ctx)
    , Check(c1, <op, v>), Check(c2, <op, v>), Act(<op, v>)
    , Accept($M, A2, <op, v>, tid), Chain($M, H, A1, c1, A2, c2, tid), AuditContext($M, tid, ctx) ]->
  [ ]
#endif

lemma executable_static_task_conformant:
  exists-trace
  "Ex M P a tid H #i #j #k.
     Accept(M, P, a, tid) @ #i & TaskStatic(tid) @ #j & Intends(H, tid, <'fixed', a>) @ #k"

lemma executable_dynamic_task_conformant:
  exists-trace
  "Ex M P op v tid H S #i #j #k.
     Accept(M, P, <op, v>, tid) @ #i & Intends(H, tid, <'hole', op, S>) @ #j & Produced(S, tid, v) @ #k"

lemma witness_context_laundering:
  exists-trace
  "Ex M P a b tid H #i #k.
     Accept(M, P, a, tid) @ #i & AuditContext(M, tid, <'fixed', b>) @ #i
     & Intends(H, tid, <'fixed', b>) @ #k & not (a = b)"

lemma AUTH_every_hop_was_delegated:
  "All M H A1 c1 A2 c2 tid #i.
     Chain(M, H, A1, c1, A2, c2, tid) @ #i
     ==> (Ex #j. RootDelegated(H, A1, c1, tid) @ #j & #j < #i)
       & (Ex #k. Delegated(A1, A2, c2, tid) @ #k & #k < #i)"

lemma NOESC_action_within_root_caveat:
  "All M P a tid #i.
     Accept(M, P, a, tid) @ #i
     ==> Ex H A1 c1 #j. RootDelegated(H, A1, c1, tid) @ #j
         & (c1 = a | (Ex op x. a = <op, x> & c1 = <op, 'any'>))"

lemma ATTR_logged_principal_sent_request:
  "All M P a tid #i.
     Accept(M, P, a, tid) @ #i
     ==> Ex #j. Request(P, a, tid) @ #j & #j < #i"

lemma TASK_static_task:
  "All M P a tid #i #j.
     Accept(M, P, a, tid) @ #i & TaskStatic(tid) @ #j
     ==> Ex H #k. Intends(H, tid, <'fixed', a>) @ #k"

lemma TASK_dynamic_task:
  "All M P op v tid #i #j.
     Accept(M, P, <op, v>, tid) @ #i & TaskDynamic(tid) @ #j
     ==> Ex H S #k #l. Intends(H, tid, <'hole', op, S>) @ #k & Produced(S, tid, v) @ #l"

end
