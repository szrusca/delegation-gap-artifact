theory AbsChain
begin

builtins: signing, hashing

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction CaveatPermits:
  "All c a #i. Check(c, a) @ #i ==> (c = a | (Ex op x. a = <op, x> & c = <op, 'any'>))"

restriction ConcreteOperand:
  "All op #i. Act(<op, 'any'>) @ #i ==> F"

restriction UniqueKey:
  "All X #i #j. Register(X) @ #i & Register(X) @ #j ==> #i = #j"

restriction OneValuePerSourceAndTask:
  "All s t v w #i #j. Produced(s, t, v) @ #i & Produced(s, t, w) @ #j ==> #i = #j"

rule Register:
  [ Fr(~k) ]
  --[ Register($X) ]->
  [ !Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k)) ]

#ifdef KEYCOMP
rule Reveal:
  [ !Ltk($X, k) ]
  --[ Reveal($X) ]->
  [ Out(k) ]

restriction HumanOfAcceptedChainNotRevealed:
  "All X R A1 c1 A2 c2 t #r #i. Reveal(X) @ #r & Chain(R, X, A1, c1, A2, c2, t) @ #i ==> F"

restriction SourceOfAcceptedProvenanceNotRevealed:
  "All X t v #r #i. Reveal(X) @ #r & ProvFrom(X, t, v) @ #i ==> F"
#endif

rule Human_static_task:
  let c   = <'push', 'any'>
      t   = <'fixed', 'push', $repo>
      d1  = <'root', $H, $A1, c, ~tid>
      cap = <'cap', $H, ~tid, t>
  in
  [ Fr(~tid), !Ltk($H, kH) ]
  --[ Intends($H, ~tid, t), RootDelegated($H, $A1, c, ~tid), TaskStatic(~tid) ]->
  [ Out(<d1, sign(d1, kH)>), Out(<cap, sign(cap, kH)>) ]

rule Human_dynamic_task:
  let c   = <'push', 'any'>
      t   = <'hole', 'push', $Src>
      d1  = <'root', $H, $A1, c, ~tid>
      cap = <'cap', $H, ~tid, t>
  in
  [ Fr(~tid), !Ltk($H, kH) ]
  --[ Intends($H, ~tid, t), RootDelegated($H, $A1, c, ~tid), TaskDynamic(~tid) ]->
  [ Out(<d1, sign(d1, kH)>), Out(<cap, sign(cap, kH)>) ]

rule Source_produces:
  let p = <'prov', $Src, tid, $v>
  in
  [ In(tid), !Ltk($Src, ks) ]
  --[ Produced($Src, tid, $v) ]->
  [ Out(<p, sign(p, ks)>) ]

#ifdef HONEST
rule Agent1_honest_delegation:
  let d1 = <'root', H, $A1, c1, tid>
      d2 = <'del', $A1, $A2, c1, h(<d1, s1>)>
  in
  [ In(<d1, s1>), !Pk(H, pkH), !Ltk($A1, k1), !Pk($A2, pkA2) ]
  --[ Eq(verify(s1, d1, pkH), true), Delegated($A1, $A2, c1, tid) ]->
  [ Out(<d2, sign(d2, k1)>) ]

rule Agent2_honest_request_fixed:
  let d1  = <'root', H, A1, c1, tid>
      d2  = <'del', A1, $A2, c2, h(<d1, s1>)>
      cap = <'cap', H, tid, <'fixed', op, v>>
      b   = <'req', <op, v>, $R, h(<d1, s1, d2, s2>)>
  in
  [ In(<d1, s1, d2, s2>), In(<cap, sc>), In($R), !Pk(H, pkH), !Pk(A1, pkA1), !Ltk($A2, k2) ]
  --[ Eq(verify(s1, d1, pkH), true), Eq(verify(s2, d2, pkA1), true), Eq(verify(sc, cap, pkH), true)
    , Request($A2, <op, v>, tid) ]->
  [ Out(<'req', <op, v>, d1, s1, d2, s2, sign(b, k2)>) ]

rule Agent2_honest_request_hole:
  let d1  = <'root', H, A1, c1, tid>
      d2  = <'del', A1, $A2, c2, h(<d1, s1>)>
      cap = <'cap', H, tid, <'hole', op, S>>
      p   = <'prov', S, tid, v>
      b   = <'req', <op, v>, $R, h(<d1, s1, d2, s2>)>
  in
  [ In(<d1, s1, d2, s2>), In(<cap, sc>), In(<p, sp>), In($R), !Pk(H, pkH), !Pk(A1, pkA1), !Pk(S, pkS), !Ltk($A2, k2) ]
  --[ Eq(verify(s1, d1, pkH), true), Eq(verify(s2, d2, pkA1), true), Eq(verify(sc, cap, pkH), true)
    , Eq(verify(sp, p, pkS), true), Request($A2, <op, v>, tid) ]->
  [ Out(<'req', <op, v>, d1, s1, d2, s2, sign(b, k2)>) ]

#else
rule Agent1_steered_delegation:
  let d1 = <'root', H, $A1, c1, tid>
      d2 = <'del', $A1, A2, c2, h(<d1, s1>)>
  in
  [ In(<d1, s1>), In(<A2, c2>), !Pk(H, pkH), !Ltk($A1, k1) ]
  --[ Eq(verify(s1, d1, pkH), true), Delegated($A1, A2, c2, tid) ]->
  [ Out(<d2, sign(d2, k1)>) ]

rule Agent2_steered_request:
  let d1 = <'root', H, A1, c1, tid>
      d2 = <'del', A1, $A2, c2, h(<d1, s1>)>
      b  = <'req', a, $R, h(<d1, s1, d2, s2>)>
  in
  [ In(<d1, s1, d2, s2>), In(<$R, a>), !Pk(H, pkH), !Pk(A1, pkA1), !Ltk($A2, k2) ]
  --[ Eq(verify(s1, d1, pkH), true), Eq(verify(s2, d2, pkA1), true), Request($A2, a, tid) ]->
  [ Out(<'req', a, d1, s1, d2, s2, sign(b, k2)>) ]

#endif

#ifdef REQBIND
rule Resource_receive_bound:
  let d1 = <'root', H, A1, c1, tid>
      d2 = <'del', A1, A2, c2, h(<d1, s1>)>
      b  = <'req', a, $R, h(<d1, s1, d2, s2>)>
  in
  [ In(<'req', a, d1, s1, d2, s2, sr>), !Pk(H, pkH), !Pk(A1, pkA1), !Pk(A2, pkA2) ]
  --[ Eq(verify(s1, d1, pkH), true), Eq(verify(s2, d2, pkA1), true), Eq(verify(sr, b, pkA2), true)
    , Check(c1, a), Check(c2, a), Act(a) ]->
  [ Received($R, A2, a, H, A1, c1, c2, tid) ]
#else
rule Resource_receive_bearer:
  let d1 = <'root', H, A1, c1, tid>
      d2 = <'del', A1, A2, c2, h(<d1, s1>)>
  in
  [ In(<'req', a, d1, s1, d2, s2, sr>), !Pk(H, pkH), !Pk(A1, pkA1) ]
  --[ Eq(verify(s1, d1, pkH), true), Eq(verify(s2, d2, pkA1), true)
    , Check(c1, a), Check(c2, a), Act(a) ]->
  [ Received($R, A2, a, H, A1, c1, c2, tid) ]
#endif

#ifdef not CAPSULE & not PROV
rule Resource_accept_chain_only:
  [ Received(R, P, a, H, A1, c1, c2, tid) ]
  --[ Accept(R, P, a, tid), Chain(R, H, A1, c1, P, c2, tid) ]->
  [ ]
#endif

#ifdef not CAPSULE & PROV
rule Resource_accept_any_provenance:
  let p = <'prov', S, tid, v>
  in
  [ Received(R, P, <op, v>, H, A1, c1, c2, tid), In(<p, sp>), !Pk(S, pkS) ]
  --[ Eq(verify(sp, p, pkS), true), ProvFrom(S, tid, v)
    , Accept(R, P, <op, v>, tid), Chain(R, H, A1, c1, P, c2, tid) ]->
  [ ]
#endif

#ifdef CAPSULE
rule Resource_accept_capsule_fixed:
  let cap = <'cap', H, tid, <'fixed', op, v>>
  in
  [ Received(R, P, <op, v>, H, A1, c1, c2, tid), In(<cap, sc>), !Pk(H, pkH) ]
  --[ Eq(verify(sc, cap, pkH), true)
    , Accept(R, P, <op, v>, tid), Chain(R, H, A1, c1, P, c2, tid) ]->
  [ ]
#endif

#ifdef CAPSULE & not PROV
rule Resource_accept_capsule_hole_unchecked:
  let cap = <'cap', H, tid, <'hole', op, S>>
  in
  [ Received(R, P, <op, v>, H, A1, c1, c2, tid), In(<cap, sc>), !Pk(H, pkH) ]
  --[ Eq(verify(sc, cap, pkH), true)
    , Accept(R, P, <op, v>, tid), Chain(R, H, A1, c1, P, c2, tid) ]->
  [ ]
#endif

#ifdef CAPSULE & PROV
rule Resource_accept_capsule_hole_provenance:
  let cap = <'cap', H, tid, <'hole', op, S>>
      p   = <'prov', S, tid, v>
  in
  [ Received(R, P, <op, v>, H, A1, c1, c2, tid), In(<cap, sc>), In(<p, sp>), !Pk(H, pkH), !Pk(S, pkS) ]
  --[ Eq(verify(sc, cap, pkH), true), Eq(verify(sp, p, pkS), true), ProvFrom(S, tid, v)
    , Accept(R, P, <op, v>, tid), Chain(R, H, A1, c1, P, c2, tid) ]->
  [ ]
#endif

lemma executable_static_task_conformant:
  exists-trace
  "Ex R P a tid H #i #j #k.
     Accept(R, P, a, tid) @ #i & TaskStatic(tid) @ #j & Intends(H, tid, <'fixed', a>) @ #k
     & (All X #r. Reveal(X) @ #r ==> F)"

lemma executable_dynamic_task_conformant:
  exists-trace
  "Ex R P op v tid H S #i #j #k.
     Accept(R, P, <op, v>, tid) @ #i & Intends(H, tid, <'hole', op, S>) @ #j & Produced(S, tid, v) @ #k
     & (All X #r. Reveal(X) @ #r ==> F)"

lemma AUTH_every_hop_was_delegated:
  "All R H A1 c1 A2 c2 tid #i.
     Chain(R, H, A1, c1, A2, c2, tid) @ #i
     ==> (Ex #j. RootDelegated(H, A1, c1, tid) @ #j & #j < #i)
       & (Ex #k. Delegated(A1, A2, c2, tid) @ #k & #k < #i)"

lemma NOESC_action_within_root_caveat:
  "All R P a tid #i.
     Accept(R, P, a, tid) @ #i
     ==> Ex H A1 c1 #j. RootDelegated(H, A1, c1, tid) @ #j
         & (c1 = a | (Ex op x. a = <op, x> & c1 = <op, 'any'>))"

lemma ATTR_logged_principal_sent_request:
  "All R P a tid #i.
     Accept(R, P, a, tid) @ #i
     ==> Ex #j. Request(P, a, tid) @ #j & #j < #i"

lemma TASK_static_task:
  "All R P a tid #i #j.
     Accept(R, P, a, tid) @ #i & TaskStatic(tid) @ #j
     ==> Ex H #k. Intends(H, tid, <'fixed', a>) @ #k"

lemma TASK_dynamic_task:
  "All R P op v tid #i #j.
     Accept(R, P, <op, v>, tid) @ #i & TaskDynamic(tid) @ #j
     ==> Ex H S #k #l. Intends(H, tid, <'hole', op, S>) @ #k & Produced(S, tid, v) @ #l"

end
