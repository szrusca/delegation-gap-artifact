lemma executable_static_task_conformant:
  exists-trace
  "∃ R H K Y a tid #i #j #k #q.
    ((((Accept( R, H, K, Y, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
      (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
     (Request( Y, a, tid ) @ #q)) ∧
    (¬(K = Y))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y a tid #i #j #k #q.
  (Accept( R, H, K, Y, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k) ∧
  (Request( Y, a, tid ) @ #q)
 ∧
  ¬(K = Y)"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_2
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( $X, kX ) ▶₂ #q )
        case Register
        solve( Intends( H, ~tid, <'fixed', op, x> ) @ #k.3 )
          case Human_consents_static
          solve( !KU( sign(<'obo', $H, K, $X, <'push', 'any'>, cnf, ~tid>, ~k)
                 ) @ #vk.29 )
            case AS_token_endpoint
            solve( !KU( sign(<'actor', $X>, ~k) ) @ #vk.48 )
              case Actor_joins_flow
              solve( !KU( sign(<'join', $X, ~tid>, ~k.2) ) @ #vk.50 )
                case Actor_joins_flow
                solve( !KU( ~tid ) @ #vk.30 )
                  case Human_consents_static
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
