lemma executable_static_task_conformant:
  exists-trace
  "∃ M P a tid H #i #j #k.
    ((Accept( M, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ M P a tid H #i #j #k.
  (Accept( M, P, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
  case case_2
  solve( (c2 = <op, x>)  ∥
         (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c2 = <op.1, 'any'>)) )
    case case_1
    solve( !Pk( H, pk(x.1) ) ▶₁ #i )
      case Register
      solve( !Pk( A1, pk(x.1) ) ▶₂ #i )
        case Register
        solve( !Ltk( $H, kH ) ▶₁ #j )
          case Register
          solve( Intends( H.1, ~tid, <'fixed', op, x> ) @ #k.3 )
            case Human_static_task
            solve( !KU( sign(<'b0', $X, $X.1, <'push', 'any'>, ~tid>, ~k)
                   ) @ #vk.22 )
              case Human_static_task
              solve( !KU( sign(<'blk', $A1, P, <'push', $repo>, ctx, 
                                h(<<'b0', $H, $A1, <'push', 'any'>, ~tid>, 
                                   sign(<'b0', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                               >,
                               ~k.1)
                     ) @ #vk.28 )
                case Agent1_steered_delegation_block
                solve( !KU( ~tid ) @ #vk.25 )
                  case Human_static_task
                  solve( !KU( h(<<'b0', $H, $A1, <'push', 'any'>, ~tid>, 
                                 sign(<'b0', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                         ) @ #vk.31 )
                    case Agent1_steered_delegation_block
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ M P op v tid H S #i #j #k.
    ((Accept( M, P, <op, v>, tid ) @ #i) ∧
     (Intends( H, tid, <'hole', op, S> ) @ #j)) ∧
    (Produced( S, tid, v ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ M P op v tid H S #i #j #k.
  (Accept( M, P, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #j) ∧
  (Produced( S, tid, v ) @ #k)"
*/
simplify
solve( (c1 = <op, $v>)  ∥
       (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
  case case_2
  solve( (c2 = <op, $v>)  ∥
         (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
    case case_1
    solve( !Pk( H, pk(x) ) ▶₁ #i )
      case Register
      solve( !Pk( A1, pk(x) ) ▶₂ #i )
        case Register
        solve( !Ltk( $Src, ks ) ▶₁ #k.2 )
          case Register
          solve( Intends( H, tid, <'hole', op, $Src> ) @ #j )
            case Human_dynamic_task
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !KU( sign(<'b0', $X, $X.1, <'push', 'any'>, ~tid>, ~k)
                     ) @ #vk.22 )
                case Human_dynamic_task
                solve( !KU( sign(<'blk', $A1, P, <'push', $v>, ctx, 
                                  h(<<'b0', $H, $A1, <'push', 'any'>, ~tid>, 
                                     sign(<'b0', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                 >,
                                 ~k.1)
                       ) @ #vk.28 )
                  case Agent1_steered_delegation_block
                  solve( !KU( ~tid ) @ #vk.25 )
                    case Human_dynamic_task
                    solve( !KU( h(<<'b0', $H, $A1, <'push', 'any'>, ~tid>, 
                                   sign(<'b0', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                           ) @ #vk.31 )
                      case Agent1_steered_delegation_block
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma witness_context_laundering:
  exists-trace
  "∃ M P a b tid H #i #k.
    (((Accept( M, P, a, tid ) @ #i) ∧
      (AuditContext( M, tid, <'fixed', b> ) @ #i)) ∧
     (Intends( H, tid, <'fixed', b> ) @ #k)) ∧
    (¬(a = b))"
/*
guarded formula characterizing all satisfying traces:
"∃ M P a b tid H #i #k.
  (Accept( M, P, a, tid ) @ #i) ∧
  (AuditContext( M, tid, <'fixed', b> ) @ #i) ∧
  (Intends( H, tid, <'fixed', b> ) @ #k)
 ∧
  ¬(a = b)"
*/
simplify
solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
  case case_2
  solve( (c2 = <op, x>)  ∥
         (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c2 = <op.1, 'any'>)) )
    case case_1
    solve( !Pk( H, pk(x.1) ) ▶₁ #i )
      case Register
      solve( !Pk( A1, pk(x.1) ) ▶₂ #i )
        case Register
        solve( Intends( H, tid, <'fixed', b> ) @ #k.2 )
          case Human_static_task
          solve( !Ltk( $H, kH ) ▶₁ #k.2 )
            case Register
            solve( !KU( sign(<'b0', $X, $X.1, <op, 'any'>, ~tid>, ~k) ) @ #vk.22 )
              case Human_static_task
              solve( !KU( sign(<'blk', $A1, P, <'push', x>, <'fixed', 'push', $repo>, 
                                h(<<'b0', $H, $A1, <'push', 'any'>, ~tid>, 
                                   sign(<'b0', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                               >,
                               ~k.1)
                     ) @ #vk.28 )
                case Agent1_steered_delegation_block
                solve( !KU( ~tid ) @ #vk.25 )
                  case Human_static_task
                  solve( !KU( h(<<'b0', $H, $A1, <'push', 'any'>, ~tid>, 
                                 sign(<'b0', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                         ) @ #vk.31 )
                    case Agent1_steered_delegation_block
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma AUTH_every_hop_was_delegated:
  all-traces
  "∀ M H A1 c1 A2 c2 tid #i.
    (Chain( M, H, A1, c1, A2, c2, tid ) @ #i) ⇒
    ((∃ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ∧ (#j < #i)) ∧
     (∃ #k. (Delegated( A1, A2, c2, tid ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ M H A1 c1 A2 c2 tid #i.
  (Chain( M, H, A1, c1, A2, c2, tid ) @ #i)
 ∧
  ((∀ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∀ #k. (Delegated( A1, A2, c2, tid ) @ #k) ⇒ ¬(#k < #i)))"
