lemma executable_static_task_conformant:
  exists-trace
  "∃ R H L a tid #i #j #k.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L a tid #i #j #k.
  (Accept( R, H, L, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( UpReq( M, R, H, L, a, ~tid ) ▶₀ #i )
  case Server_executes_tool_call
  solve( (<'push', 'any'> = a)  ∥
         (∃ op x. (a = <op, x>) ∧ (<'push', 'any'> = <op, 'any'>)) )
    case case_2
    solve( Intends( $H, ~tid, <'fixed', 'push', x> ) @ #k.3 )
      case Human_consents_static
      SOLVED // trace found
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R H L op v S tid #i #k #l.
    ((Accept( R, H, L, <op, v>, tid ) @ #i) ∧
     (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
    (Produced( S, tid, v ) @ #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L op v S tid #i #k #l.
  (Accept( R, H, L, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l)"
*/
simplify
solve( UpReq( M, R, H, L, <op, $v>, tid ) ▶₀ #i )
  case Server_executes_tool_call_case_2
  solve( (<'push', 'any'> = <op, $v>)  ∥
         (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (<'push', 'any'> = <op.1, 'any'>)) )
    case case_2
    solve( !TaskOpen( ~tid, $Src ) ▶₀ #l )
      case Human_consents_dynamic
      solve( !Ltk( $Src, ks ) ▶₁ #l )
        case Register
        solve( Intends( $H, ~tid, <'hole', 'push', $Src> ) @ #k.4 )
          case Human_consents_dynamic
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

lemma witness_cross_server_token_replay:
  exists-trace
  "∃ M M2 H C a s tid #i #j.
    ((ToolExec( M, H, C, a, tid ) @ #i) ∧
     (Consent( H, C, M2, s, tid ) @ #j)) ∧
    (¬(M = M2))"
/*
guarded formula characterizing all satisfying traces:
"∃ M M2 H C a s tid #i #j.
  (ToolExec( M, H, C, a, tid ) @ #i) ∧ (Consent( H, C, M2, s, tid ) @ #j)
 ∧
  ¬(M = M2)"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( CallTLS( a, $M, $R, <'at', H, C, $M, a, cnf, tid>,
                  sign(<'at', H, C, $M, a, cnf, tid>, x), pr
         ) ▶₀ #i )
    case Agent_calls_tool_case_1
    by contradiction /* from formulas */
  next
    case Agent_calls_tool_case_2
    by contradiction /* from formulas */
  next
    case Agent_calls_tool_case_3
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( CallTLS( <op, x>, $M, $R, <'at', H, C, $M, <op, 'any'>, cnf, tid>,
                  sign(<'at', H, C, $M, <op, 'any'>, cnf, tid>, x.1), pr
         ) ▶₀ #i )
    case Agent_calls_tool_case_1
    solve( !Pk( 'AS', pk(~k) ) ▶₁ #i )
      case Register
      solve( !UpTok( $M, $H, $R ) ▶₂ #i )
        case Human_authorizes_server_upstream
        solve( Consent( $H, $C, M2, s, ~tid ) @ #j )
          case Human_consents_static
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case Agent_calls_tool_case_2
    solve( !Pk( 'AS', pk(~k) ) ▶₁ #i )
      case Register
      solve( !UpTok( $M, $H, $R ) ▶₂ #i )
        case Human_authorizes_server_upstream
        solve( Consent( $H, $C, M2, s, ~tid ) @ #j )
          case Human_consents_dynamic
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case Agent_calls_tool_case_3
    solve( !Pk( 'AS', pk(~k) ) ▶₁ #i )
      case Register
      solve( !UpTok( $M, $H, $R ) ▶₂ #i )
        case Human_authorizes_server_upstream
        solve( Consent( $H, $C, M2, s, ~tid ) @ #j )
          case Human_consents_other
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

