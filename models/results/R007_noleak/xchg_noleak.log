  /* has exactly the trivial AC variant */

rule (modulo E) Agent_calls_tool:
   [
   !HeldBy( $C, <'at', H, $C, aud, s, cnf, tid>, ts ), In( <$M, $R, a> ),
   !Ltk( $C, kC )
   ]
  --[ Request( $C, a, tid ) ]->
   [
   CallTLS( a, $M, $R, <'at', H, $C, aud, s, cnf, tid>, ts,
            sign(<'dpop', a, $M, h(<<'at', H, $C, aud, s, cnf, tid>, ts>)>, kC)
   )
   ]

  /* has exactly the trivial AC variant */

