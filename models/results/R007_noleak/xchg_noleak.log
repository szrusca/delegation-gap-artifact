lemma witness_identity_collapse:
  exists-trace
  "∃ R H L M a b t1 t2 C1 C2 #i #j #k #l.
    ((((Accept( R, H, L, a, t1 ) @ #i) ∧ (Accept( R, H, L, b, t2 ) @ #j)) ∧
      (ToolExec( M, H, C1, a, t1 ) @ #k)) ∧
     (ToolExec( M, H, C2, b, t2 ) @ #l)) ∧
    (¬(C1 = C2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L M a b t1 t2 C1 C2 #i #j #k #l.
  (Accept( R, H, L, a, t1 ) @ #i) ∧
  (Accept( R, H, L, b, t2 ) @ #j) ∧
  (ToolExec( M, H, C1, a, t1 ) @ #k) ∧
  (ToolExec( M, H, C2, b, t2 ) @ #l)
 ∧
  ¬(C1 = C2)"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( (s = b)  ∥ (∃ op x. (b = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_1
    solve( UpReq( M, R, H, L, a, t1 ) ▶₀ #i )
      case Server_executes_tool_call_case_1
      solve( (<'push', 'any'> = a)  ∥
             (∃ op x. (a = <op, x>) ∧ (<'push', 'any'> = <op, 'any'>)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        solve( UpReq( M.1, $R, $H, $C, b, t2 ) ▶₀ #j )
          case Server_executes_tool_call_case_1
          solve( (<'push', 'any'> = b)  ∥
                 (∃ op x. (b = <op, x>) ∧ (<'push', 'any'> = <op, 'any'>)) )
            case case_1
            by contradiction /* from formulas */
          next
            case case_2
            solve( CallTLS( <'push', x>, $M.2, $R.1,
                            <'at', $H, C1, $M.2, <'push', x>, cnf, ~tid>,
                            sign(<'at', $H, C1, $M.2, <'push', x>, cnf, ~tid>, x.2), pr
                   ) ▶₀ #k )
              case Agent_calls_tool
              by contradiction /* from formulas */
            qed
          qed
        next
          case Server_executes_tool_call_case_2
          solve( (<'push', 'any'> = b)  ∥
                 (∃ op x. (b = <op, x>) ∧ (<'push', 'any'> = <op, 'any'>)) )
            case case_1
            by contradiction /* from formulas */
          next
            case case_2
            solve( CallTLS( <'push', x>, $M.2, $R.1,
                            <'at', $H, C1, $M.2, <'push', x>, cnf, ~tid>,
                            sign(<'at', $H, C1, $M.2, <'push', x>, cnf, ~tid>, x.2), pr
                   ) ▶₀ #k )
              case Agent_calls_tool
              by contradiction /* from formulas */
            qed
          qed
        next
          case Server_executes_tool_call_case_3
          solve( (<$op, 'any'> = b)  ∥
                 (∃ op.1 x. (b = <op.1, x>) ∧ (<$op, 'any'> = <op.1, 'any'>)) )
            case case_1
            by contradiction /* from formulas */
          next
            case case_2
            solve( CallTLS( <'push', x>, $M.2, $R.1,
                            <'at', $H, C1, $M.2, <'push', x>, cnf, ~tid>,
                            sign(<'at', $H, C1, $M.2, <'push', x>, cnf, ~tid>, x.2), pr
                   ) ▶₀ #k )
              case Agent_calls_tool
              by contradiction /* from formulas */
            qed
          qed
        qed
