rule (modulo E) Register:
   [ Fr( ~k ) ]
  --[ Register( $X ) ]->
   [ !Ltk( $X, ~k ), !Pk( $X, pk(~k) ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_authorizes_server_upstream:
   [ !Ltk( $H, kH ) ]
  --[ UpConsent( $H, $M, $R ) ]->
   [ !UpTok( $M, $H, $R ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_consents_static:
   [ Fr( ~tid ), !Ltk( $H, kH ), !Ltk( 'AS', kAS ) ]
  --[
  Consent( $H, $C, $M, <'push', 'any'>, ~tid ),
  Intends( $H, ~tid, <'fixed', 'push', $repo> ), TaskStatic( ~tid )
  ]->
   [
   !HeldBy( $C, <'at', $H, $C, $M, <'push', 'any'>, 'none', ~tid>,
            sign(<'at', $H, $C, $M, <'push', 'any'>, 'none', ~tid>, kAS)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_consents_dynamic:
   [ Fr( ~tid ), !Ltk( $H, kH ), !Ltk( 'AS', kAS ) ]
  --[
  Consent( $H, $C, $M, <'push', 'any'>, ~tid ),
  Intends( $H, ~tid, <'hole', 'push', $Src> ), TaskDynamic( ~tid )
  ]->
   [
   !HeldBy( $C, <'at', $H, $C, $M, <'push', 'any'>, 'none', ~tid>,
            sign(<'at', $H, $C, $M, <'push', 'any'>, 'none', ~tid>, kAS)
   ),
   !TaskOpen( ~tid, $Src )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_consents_other:
   [ Fr( ~tid ), !Ltk( $H, kH ), !Ltk( 'AS', kAS ) ]
  --[ Consent( $H, $C, $M, <$op, 'any'>, ~tid ), OtherGrant( ~tid ) ]->
   [
   !HeldBy( $C, <'at', $H, $C, $M, <$op, 'any'>, 'none', ~tid>,
            sign(<'at', $H, $C, $M, <$op, 'any'>, 'none', ~tid>, kAS)
