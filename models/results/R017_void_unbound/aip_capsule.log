lemma AUTH_every_hop_was_delegated:
  all-traces
  "∀ M H A1 c1 A2 c2 tid #i.
    (Chain( M, H, A1, c1, A2, c2, tid ) @ #i) ⇒
    ((∃ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ∧ (#j < #i)) ∧
     (∃ #k. (Delegated( A1, A2, c2, tid ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ M H A1 c1 A2 c2 tid #i.
  (Chain( M, H, A1, c1, A2, c2, tid ) @ #i)
 ∧
  ((∀ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∀ #k. (Delegated( A1, A2, c2, tid ) @ #k) ⇒ ¬(#k < #i)))"
*/
simplify
solve( (∀ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ⇒ ¬(#j < #i))  ∥
       (∀ #k. (Delegated( A1, A2, c2, tid ) @ #k) ⇒ ¬(#k < #i)) )
  case case_1
  solve( Chain( M, H, A1, c1, A2, c2, tid ) @ #i )
    case Server_accepts_capsule_fixed
    solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
      case case_1
      solve( (c2 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c2 = <op, 'any'>)) )
        case case_1
        solve( !Pk( H, pk(x) ) ▶₂ #i )
          case Register
          solve( !Pk( A1, pk(x) ) ▶₃ #i )
            case Register
            solve( !KU( sign(<'b0', $X, $X.1, a, tid>, ~k) ) @ #vk.26 )
              case Human_dynamic_task_case_2
              solve( !KU( sign(<'blk', $X.1, A2, a, ctx, 
                                h(<<'b0', $X, $X.1, a, tid>, sign(<'b0', $X, $X.1, a, tid>, ~k)>)>,
                               ~k.1)
                     ) @ #vk.32 )
                case Agent1_steered_delegation_block
                solve( !KU( sign(<'cap', $X, tid, 'fixed', a>, ~k) ) @ #vk.38 )
                  case Human_dynamic_task_case_1
                  solve( !KU( h(<<'b0', $X, $X.1, a, tid>, 
                                 sign(<'b0', $X, $X.1, a, tid>, ~k)>)
                         ) @ #vk.36 )
                    case Agent1_steered_delegation_block
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
