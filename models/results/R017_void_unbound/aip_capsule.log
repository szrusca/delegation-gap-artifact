lemma executable_static_task_conformant:
  exists-trace
  "∃ M P a tid H #i #j #k.
    ((Accept( M, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ M P a tid H #i #j #k.
  (Accept( M, P, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( !Ltk( $H, kH ) ▶₁ #j )
  case Register
  solve( Accept( M, P, a, ~tid ) @ #i )
    case Server_accepts_capsule_fixed
    solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
      case case_1
      solve( (c2 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c2 = <op, 'any'>)) )
        case case_1
        solve( !Pk( H, pk(x) ) ▶₂ #i )
          case Register
          solve( !Pk( A1, pk(x) ) ▶₃ #i )
            case Register
            solve( Intends( H.1, ~tid, <'fixed', a> ) @ #k.3 )
              case Human_static_task
              solve( !KU( sign(<'b0', $X, $X.1, <'push', $repo>, ~tid>, ~k)
                     ) @ #vk.26 )
                case Human_dynamic_task
                solve( !KU( sign(<'blk', $X.1, P, <'push', $repo>, ctx, 
                                  h(<<'b0', $X, $X.1, <'push', $repo>, ~tid>, 
                                     sign(<'b0', $X, $X.1, <'push', $repo>, ~tid>, ~k)>)
                                 >,
                                 ~k.1)
                       ) @ #vk.32 )
                  case Agent1_steered_delegation_block
                  solve( !KU( sign(<'cap', $X, ~tid, 'fixed', 'push', $repo>, ~k)
                         ) @ #vk.38 )
                    case Human_dynamic_task
                    solve( !KU( ~tid ) @ #vk.31 )
                      case Human_dynamic_task
                      solve( !KU( h(<<'b0', $X, $X.1, <'push', $repo>, ~tid>, 
                                     sign(<'b0', $X, $X.1, <'push', $repo>, ~tid>, ~k)>)
                             ) @ #vk.36 )
                        case Agent1_steered_delegation_block
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

