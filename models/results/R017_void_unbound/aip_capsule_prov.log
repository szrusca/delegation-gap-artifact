lemma executable_static_task_conformant:
  exists-trace
  "∃ M P a tid H #i #j #k.
    ((Accept( M, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ M P a tid H #i #j #k.
  (Accept( M, P, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( !Ltk( $H, kH ) ▶₁ #j )
  case Register
  solve( Accept( M, P, a, ~tid ) @ #i )
    case Server_accepts_capsule_fixed
    solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
      case case_1
      solve( (c2 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c2 = <op, 'any'>)) )
        case case_1
        solve( !Pk( H, pk(x) ) ▶₂ #i )
          case Register
          solve( !Pk( A1, pk(x) ) ▶₃ #i )
            case Register
            solve( Intends( H.1, ~tid, <'fixed', a> ) @ #k.3 )
              case Human_static_task
              solve( !KU( sign(<'b0', $X, $X.1, <'push', $repo>, ~tid>, ~k)
                     ) @ #vk.26 )
                case Human_dynamic_task
                solve( !KU( sign(<'blk', $X.1, P, <'push', $repo>, ctx, 
                                  h(<<'b0', $X, $X.1, <'push', $repo>, ~tid>, 
                                     sign(<'b0', $X, $X.1, <'push', $repo>, ~tid>, ~k)>)
                                 >,
                                 ~k.1)
                       ) @ #vk.32 )
                  case Agent1_steered_delegation_block
                  solve( !KU( sign(<'cap', $X, ~tid, 'fixed', 'push', $repo>, ~k)
                         ) @ #vk.38 )
                    case Human_dynamic_task
                    solve( !KU( ~tid ) @ #vk.31 )
                      case Human_dynamic_task
                      solve( !KU( h(<<'b0', $X, $X.1, <'push', $repo>, ~tid>, 
                                     sign(<'b0', $X, $X.1, <'push', $repo>, ~tid>, ~k)>)
                             ) @ #vk.36 )
                        case Agent1_steered_delegation_block
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ M P op v tid H S #i #j #k.
    ((Accept( M, P, <op, v>, tid ) @ #i) ∧
     (Intends( H, tid, <'hole', op, S> ) @ #j)) ∧
    (Produced( S, tid, v ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ M P op v tid H S #i #j #k.
  (Accept( M, P, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #j) ∧
  (Produced( S, tid, v ) @ #k)"
*/
simplify
solve( !Ltk( $Src, ks ) ▶₁ #k )
  case Register
  solve( Accept( M, P, <op, $v>, tid ) @ #i )
    case Server_accepts_capsule_fixed
    solve( (c1 = <op, $v>)  ∥
           (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
      case case_1
      solve( (c2 = <op, $v>)  ∥
             (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
        case case_1
        solve( !Pk( H, pk(x) ) ▶₂ #i )
          case Register
          solve( !Pk( A1, pk(x) ) ▶₃ #i )
            case Register
            solve( Intends( H, tid, <'hole', op, $Src> ) @ #j )
              case Human_dynamic_task
              solve( !Ltk( $H, kH ) ▶₁ #j )
                case Register
                solve( !KU( sign(<'b0', $X, $X.1, <'push', $v>, ~tid>, ~k) ) @ #vk.26 )
                  case Human_dynamic_task_case_2
                  solve( !KU( sign(<'blk', $X.1, P, <'push', $v>, ctx, 
                                    h(<<'b0', $X, $X.1, <'push', $v>, ~tid>, 
                                       sign(<'b0', $X, $X.1, <'push', $v>, ~tid>, ~k)>)
                                   >,
                                   ~k.1)
                         ) @ #vk.32 )
                    case Agent1_steered_delegation_block
                    solve( !KU( sign(<'cap', $X, ~tid, 'fixed', 'push', $v>, ~k) ) @ #vk.38 )
                      case Human_dynamic_task_case_1
                      solve( !KU( ~tid ) @ #vk.7 )
                        case Human_dynamic_task_case_1
                        solve( !KU( h(<<'b0', $X, $X.1, <'push', $v>, ~tid>, 
                                       sign(<'b0', $X, $X.1, <'push', $v>, ~tid>, ~k)>)
                               ) @ #vk.36 )
                          case Agent1_steered_delegation_block
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma witness_context_laundering:
  exists-trace
  "∃ M P a b tid H #i #k.
    (((Accept( M, P, a, tid ) @ #i) ∧
      (AuditContext( M, tid, <'fixed', b> ) @ #i)) ∧
     (Intends( H, tid, <'fixed', b> ) @ #k)) ∧
    (¬(a = b))"
/*
guarded formula characterizing all satisfying traces:
"∃ M P a b tid H #i #k.
  (Accept( M, P, a, tid ) @ #i) ∧
  (AuditContext( M, tid, <'fixed', b> ) @ #i) ∧
  (Intends( H, tid, <'fixed', b> ) @ #k)
 ∧
  ¬(a = b)"
*/
simplify
solve( Accept( M, P, a, tid ) @ #i )
  case Server_accepts_capsule_fixed
  solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
    case case_1
    solve( (c2 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c2 = <op, 'any'>)) )
      case case_1
      solve( !Pk( H, pk(x) ) ▶₂ #i )
        case Register
        solve( !Pk( A1, pk(x) ) ▶₃ #i )
          case Register
          solve( AuditContext( $M, tid, <'fixed', b> ) @ #i )
            case Server_accepts_capsule_fixed
            solve( Intends( H, tid, <'fixed', b> ) @ #k.2 )
              case Human_static_task
              solve( !Ltk( $H, kH ) ▶₁ #k.2 )
                case Register
                solve( !KU( sign(<'b0', $X, $X.1, a, ~tid>, ~k) ) @ #vk.26 )
