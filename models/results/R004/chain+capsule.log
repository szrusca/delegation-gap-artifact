lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R op v tid H S A1 c1 A2 c2 A3 c3 #i #c #j #k.
    ((((((Accept( R, A3, <op, v>, tid ) @ #i) ∧
         (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c)) ∧
        (Intends( H, tid, <'hole', op, S> ) @ #j)) ∧
       (Produced( S, tid, v ) @ #k)) ∧
      (¬(A1 = A2))) ∧
     (¬(A2 = A3))) ∧
    (¬(A1 = A3))"
/*
guarded formula characterizing all satisfying traces:
"∃ R op v tid H S A1 c1 A2 c2 A3 c3 #i #c #j #k.
  (Accept( R, A3, <op, v>, tid ) @ #i) ∧
  (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #j) ∧
  (Produced( S, tid, v ) @ #k)
 ∧
  (¬(A1 = A2)) ∧ (¬(A2 = A3)) ∧ (¬(A1 = A3))"
*/
simplify
solve( !Ltk( $Src, ks ) ▶₁ #k )
  case Register
  solve( Accept( R, A3, <op, $v>, tid ) @ #i )
    case Resource_accept_capsule_hole_unchecked
    solve( Received( R, A3, <op, $v>, H, A1, c1, A2, c2, c3, tid ) ▶₀ #i )
      case Resource_receive_bearer
      solve( (c1 = <op, $v>)  ∥
             (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
        case case_2
        solve( (c2 = <op, $v>)  ∥
               (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
          case case_1
