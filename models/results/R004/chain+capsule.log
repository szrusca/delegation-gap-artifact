              case Register
              solve( Chain( $R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c )
                case Resource_accept_capsule_hole_unchecked
                solve( Received( $R, A3, <op, v>, H, A1, c1, A2, c2, c3, tid ) ▶₀ #c )
