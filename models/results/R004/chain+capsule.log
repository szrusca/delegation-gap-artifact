                                                         sign(<'root', $X, $A1, <'push', 'any'>, ~tid>, ~k), 
                                                         <'del', $A1, $X.3, <'push', $v.1>, 
                                                          h(<<'root', $X, $A1, <'push', 'any'>, ~tid>, 
                                                             sign(<'root', $X, $A1, <'push', 'any'>, ~tid>,
                                                                  ~k)
                                                            >)
                                                         >, 
                                                         sign(<'del', $A1, $X.3, <'push', $v.1>, 
                                                               h(<<'root', $X, $A1, <'push', 'any'>, ~tid>, 
                                                                  sign(<'root', $X, $A1, <'push', 'any'>, ~tid
                                                                       >,
                                                                       ~k)
                                                                 >)
                                                              >,
                                                              ~k.2)
                                                        >)
                                                     >,
                                                     ~k.3)
                                           ) @ #vk.67 )
                                      case Agent2_steered_delegation
                                      solve( !KU( sign(<'cap', $X, ~tid, 'hole', op, S>, ~k) ) @ #vk.84 )
                                        case Human_dynamic_task
                                        solve( !KU( sign(<'root', $X, $X.1, <'push', 'any'>, ~tid>, ~k)
                                               ) @ #vk.75 )
                                          case Human_dynamic_task
                                          solve( !KU( sign(<'del', $A1, $X.1, <'push', v>, 
                                                            h(<<'root', $X, $A1, <'push', 'any'>, ~tid>, 
                                                               sign(<'root', $X, $A1, <'push', 'any'>, ~tid>,
                                                                    ~k)
                                                              >)
                                                           >,
                                                           ~k.2)
                                                 ) @ #vk.72 )
                                            case Agent1_steered_delegation
                                            solve( !KU( sign(<'del', $X.1, A3, <'push', v>, 
                                                              h(<<'root', $X, $A1, <'push', 'any'>, ~tid>, 
                                                                 sign(<'root', $X, $A1, <'push', 'any'>, ~tid
                                                                      >,
                                                                      ~k), 
                                                                 <'del', $A1, $X.1, <'push', v>, 
                                                                  h(<
                                                                     <'root', $X, $A1, <'push', 'any'>, ~tid
                                                                     >, 
                                                                     sign(<'root', $X, $A1, <'push', 'any'>, 
                                                                           ~tid>,
                                                                          ~k)
                                                                    >)
                                                                 >, 
                                                                 sign(<'del', $A1, $X.1, <'push', v>, 
                                                                       h(<
                                                                          <'root', $X, $A1, <'push', 'any'>, 
                                                                           ~tid>, 
                                                                          sign(<'root', $X, $A1, 
                                                                                <'push', 'any'>, ~tid>,
                                                                               ~k)
                                                                         >)
                                                                      >,
                                                                      ~k.2)
                                                                >)
                                                             >,
                                                             ~k.5)
                                                   ) @ #vk.76 )
                                              case Agent2_steered_delegation
                                              solve( !KU( ~tid ) @ #vk.25 )
                                                case Human_dynamic_task_case_1
                                                solve( !KU( h(<<'root', $X, $A1, <'push', 'any'>, ~tid>, 
                                                               sign(<'root', $X, $A1, <'push', 'any'>, ~tid>,
                                                                    ~k)
                                                              >)
                                                       ) @ #vk.73 )
                                                  case Agent1_steered_delegation
                                                  solve( !KU( h(<<'root', $X, $A1, <'push', 'any'>, ~tid>, 
                                                                 sign(<'root', $X, $A1, <'push', 'any'>, ~tid
                                                                      >,
                                                                      ~k), 
                                                                 <'del', $A1, $X.2, <'push', $v.1>, 
                                                                  h(<
                                                                     <'root', $X, $A1, <'push', 'any'>, ~tid
                                                                     >, 
                                                                     sign(<'root', $X, $A1, <'push', 'any'>, 
                                                                           ~tid>,
                                                                          ~k)
                                                                    >)
                                                                 >, 
                                                                 sign(<'del', $A1, $X.2, <'push', $v.1>, 
                                                                       h(<
                                                                          <'root', $X, $A1, <'push', 'any'>, 
                                                                           ~tid>, 
                                                                          sign(<'root', $X, $A1, 
                                                                                <'push', 'any'>, ~tid>,
                                                                               ~k)
                                                                         >)
                                                                      >,
                                                                      ~k.2)
                                                                >)
