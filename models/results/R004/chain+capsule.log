                           (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
                      case case_1
                      solve( (c3 = <op, v>)  ∥
                             (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c3 = <op.1, 'any'>)) )
                        case case_1
                        solve( !Pk( $X, pk(x) ) ▶₂ #c )
                          case Register
                          solve( Intends( $X, tid, <'hole', op.1, $Src> ) @ #j )
                            case Human_dynamic_task
                            solve( !Ltk( $X, kH ) ▶₁ #j )
                              case Register
                              solve( !KU( sign(<'cap', $X.3, ~tid, 'hole', 'push', S.1>, ~k.1)
                                     ) @ #vk.45 )
                                case Human_dynamic_task
                                solve( !KU( sign(<'root', $X, $X.3, <'push', 'any'>, ~tid>, ~k)
                                       ) @ #vk.49 )
                                  case Human_dynamic_task
                                  solve( !KU( sign(<'del', $A1, $X.3, <'push', $v.1>, 
