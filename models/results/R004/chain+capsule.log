lemma executable_static_task_conformant:
  exists-trace
  "∃ R a tid H A1 c1 A2 c2 A3 c3 #i #c #j #k.
    ((((((Accept( R, A3, a, tid ) @ #i) ∧
         (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c)) ∧
        (TaskStatic( tid ) @ #j)) ∧
       (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
      (¬(A1 = A2))) ∧
     (¬(A2 = A3))) ∧
    (¬(A1 = A3))"
/*
guarded formula characterizing all satisfying traces:
"∃ R a tid H A1 c1 A2 c2 A3 c3 #i #c #j #k.
  (Accept( R, A3, a, tid ) @ #i) ∧
  (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  (¬(A1 = A2)) ∧ (¬(A2 = A3)) ∧ (¬(A1 = A3))"
*/
simplify
solve( !Ltk( $H, kH ) ▶₁ #j )
  case Register
  solve( Accept( R, A3, a, ~tid ) @ #i )
    case Resource_accept_capsule_fixed
    solve( Received( R, A3, <op, v>, H, A1, c1, A2, c2, c3, ~tid ) ▶₀ #i )
      case Resource_receive_bearer
      solve( (c1 = <op, v>)  ∥
             (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
        case case_2
        solve( (c2 = <op, v>)  ∥
               (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
          case case_1
          solve( (c3 = <op, v>)  ∥
                 (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c3 = <op.1, 'any'>)) )
            case case_1
            solve( !Pk( $X, pk(x) ) ▶₂ #i )
              case Register
              solve( Chain( $R, H.1, A1.1, c1, A2, c2, A3, c3, ~tid ) @ #c )
                case Resource_accept_capsule_fixed
                solve( Received( $R, A3, <op, v>, H, A1, c1, A2, c2, c3, ~tid ) ▶₀ #c )
                  case Resource_receive_bearer
                  solve( (c1 = <op, v>)  ∥
                         (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
                    case case_2
                    solve( (c2 = <op, v>)  ∥
                           (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
                      case case_1
                      solve( (c3 = <op, v>)  ∥
                             (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c3 = <op.1, 'any'>)) )
                        case case_1
                        solve( !Pk( $X, pk(x) ) ▶₂ #c )
                          case Register
                          solve( Intends( $X, ~tid, <'fixed', op.1, v.1> ) @ #k.8 )
                            case Human_static_task
                            solve( !KU( sign(<'cap', $X.2, ~tid, 'fixed', 'push', $repo>, ~k.1)
                                   ) @ #vk.43 )
                              case Human_static_task
                              solve( !KU( sign(<'root', $H, $X.2, <'push', 'any'>, ~tid>, ~k)
