              case Register
              solve( !KU( sign(<'cap', $X, tid, 'fixed', op, v>, ~k) ) @ #vk.24 )
                case Human_static_task
                solve( !KU( sign(<'root', $X, $X.1, <'push', $repo>, ~tid>, ~k)
                       ) @ #vk.32 )
                  case Human_static_task
                  by contradiction /* from formulas */
                next
                  case c_sign
                  by solve( !KU( ~k ) @ #vk.45 )
                qed
              next
                case c_sign
                by solve( !KU( ~k ) @ #vk.45 )
              qed
            qed
          next
            case case_2
            solve( !Pk( $X, pk(x) ) ▶₂ #i )
              case Register
              solve( !KU( sign(<'cap', $X, tid, 'fixed', op, v>, ~k) ) @ #vk.24 )
                case Human_static_task
                solve( !KU( sign(<'root', $X, $X.1, <'push', $repo>, ~tid>, ~k)
