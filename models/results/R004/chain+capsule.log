            <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2>)
        >, 
        s3, sr>
   ),
   !Pk( H, pkH ), !Pk( A1, pkA1 ), !Pk( A2, pkA2 )
   ]
