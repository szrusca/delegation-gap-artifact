rule (modulo E) Resource_accept_capsule_fixed:
   [
   Received( R, P, <op, v>, H, A1, c1, A2, c2, c3, tid ),
   In( <<'cap', H, tid, 'fixed', op, v>, sc> ), !Pk( H, pkH )
   ]
  --[
  Eq( verify(sc, <'cap', H, tid, 'fixed', op, v>, pkH), true ),
  Accept( R, P, <op, v>, tid ), Chain( R, H, A1, c1, A2, c2, P, c3, tid )
  ]->
   [ ]

  /*
  rule (modulo AC) Resource_accept_capsule_fixed:
     [
     Received( R, P, <op, v>, H, A1, c1, A2, c2, c3, tid ),
     In( <<'cap', H, tid, 'fixed', op, v>, sc> ), !Pk( H, pkH )
     ]
    --[
    Eq( z, true ), Accept( R, P, <op, v>, tid ),
    Chain( R, H, A1, c1, A2, c2, P, c3, tid )
    ]->
     [ ]
    variants (modulo AC)
    1. H     = H.28
       op    = op.34
       pkH   = pkH.35
       sc    = sc.36
       tid   = tid.37
       v     = v.38
       z     = verify(sc.36, <'cap', H.28, tid.37, 'fixed', op.34, v.38>,
                      pkH.35)
    
    2. H     = H.39
       op    = op.45
       pkH   = pk(x.74)
       sc    = sign(<'cap', H.39, tid.48, 'fixed', op.45, v.49>, x.74)
       tid   = tid.48
       v     = v.49
       z     = true
  */

