  all-traces
  "∀ R H A1 c1 A2 c2 A3 c3 tid #i.
    (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #i) ⇒
    (((∃ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ∧ (#j < #i)) ∧
      (∃ #k. (Delegated( A1, A2, c2, tid ) @ #k) ∧ (#k < #i))) ∧
     (∃ #l. (Delegated( A2, A3, c3, tid ) @ #l) ∧ (#l < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ R H A1 c1 A2 c2 A3 c3 tid #i.
  (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #i)
 ∧
  ((∀ #j. (RootDelegated( H, A1, c1, tid ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∀ #k. (Delegated( A1, A2, c2, tid ) @ #k) ⇒ ¬(#k < #i)) ∨
