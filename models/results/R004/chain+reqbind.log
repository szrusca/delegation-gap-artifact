                                                       >)
                                                    >,
                                                    ~k.2)
                                              >)
                                           >,
                                           ~k.3)
                                 ) @ #vk.56 )
                            case Agent3_steered_request
                            solve( !KU( sign(<'root', $H, $X.1, <op, 'any'>, ~tid>, ~k) ) @ #vk.73 )
                              case Human_static_task
                              solve( !KU( sign(<'del', $A1, $X.1, <'push', x>, 
                                                h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                   sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                               >,
                                               ~k.1)
                                     ) @ #vk.68 )
                                case Agent1_steered_delegation
                                solve( !KU( sign(<'del', $X.1, $X, <'push', x>, 
