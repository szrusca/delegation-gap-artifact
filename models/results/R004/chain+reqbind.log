lemma TASK_static_task:
  all-traces
  "∀ R P a tid #i #j.
    ((Accept( R, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ⇒
    (∃ H #k. Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all counter-examples:
"∃ R P a tid #i #j.
  (Accept( R, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)
 ∧
  ∀ H #k. (Intends( H, tid, <'fixed', a> ) @ #k) ⇒ ⊥"
*/
simplify
solve( Received( R, P, a, H, A1, c1, A2, c2, c3, ~tid ) ▶₀ #i )
  case Resource_receive_bound
  solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
    case case_2
    solve( (c2 = <op, x>)  ∥
           (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c2 = <op.1, 'any'>)) )
