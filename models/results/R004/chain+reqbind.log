lemma NOESC_action_within_root_caveat:
  all-traces
  "∀ R P a tid #i.
    (Accept( R, P, a, tid ) @ #i) ⇒
    (∃ H A1 c1 #j.
      (RootDelegated( H, A1, c1, tid ) @ #j) ∧
      ((c1 = a) ∨ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>))))"
/*
guarded formula characterizing all counter-examples:
"∃ R P a tid #i.
  (Accept( R, P, a, tid ) @ #i)
 ∧
  ∀ H A1 c1 #j.
   (RootDelegated( H, A1, c1, tid ) @ #j)
  ⇒
   (¬(c1 = a)) ∧ (∀ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>) ⇒ ⊥)"
*/
simplify
solve( Received( R, P, a, H, A1, c1, A2, c2, c3, tid ) ▶₀ #i )
  case Resource_receive_bound
  solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
