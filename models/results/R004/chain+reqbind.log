    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction CaveatPermits:
  "∀ c a #i.
    (Check( c, a ) @ #i) ⇒
    ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))"

  /*
  expanded formula:
  "∀ c a #i.
    (Check( c, a ) @ #i) ⇒
    ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))"
  */

restriction ConcreteOperand:
  "∀ op #i. (Act( <op, 'any'> ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ op #i. (Act( <op, 'any'> ) @ #i) ⇒ (⊥)"
  */

restriction UniqueKey:
  "∀ X #i #j. ((Register( X ) @ #i) ∧ (Register( X ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ X #i #j. ((Register( X ) @ #i) ∧ (Register( X ) @ #j)) ⇒ (#i = #j)"
  */

restriction OneValuePerSourceAndTask:
  "∀ s t v w #i #j.
    ((Produced( s, t, v ) @ #i) ∧ (Produced( s, t, w ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ s t v w #i #j.
    ((Produced( s, t, v ) @ #i) ∧ (Produced( s, t, w ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Register:
   [ Fr( ~k ) ]
  --[ Register( $X ) ]->
   [ !Ltk( $X, ~k ), !Pk( $X, pk(~k) ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

