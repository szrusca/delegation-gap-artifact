                                                              h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                                 sign(<'root', $H, $A1, <'push', 'any'>, ~tid
                                                                      >,
                                                                      ~k)
                                                                >)
                                                             >,
