                   (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c2 = <op.1, 'any'>)) )
              case case_1
              solve( (c3 = <op, x>)  ∥
                     (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c3 = <op.1, 'any'>)) )
                case case_1
                solve( !Ltk( $H, kH ) ▶₁ #j )
                  case Register
                  solve( Intends( $X.1, ~tid, <'fixed', op.1, x.1> ) @ #k.8 )
                    case Human_static_task
                    solve( !KU( sign(<'root', $X.3, $X.4, <'push', 'any'>, ~tid>, ~k.1)
                           ) @ #vk.33 )
                      case Human_static_task
                      solve( !KU( sign(<'del', $A1, $X.3, <'push', $repo>, 
                                        h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                           sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                       >,
                                       ~k.1)
                             ) @ #vk.43 )
                        case Agent1_steered_delegation
                        solve( !KU( sign(<'del', $X.3, $X, <'push', $repo>, 
                                          h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                             sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k), 
