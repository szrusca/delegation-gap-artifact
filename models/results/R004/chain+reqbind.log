rule (modulo E) Resource_receive_bound:
   [
   In( <'req', a, <'root', H, A1, c1, tid>, s1, 
        <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2, 
        <'del', A2, A3, c3, 
         h(<<'root', H, A1, c1, tid>, s1, 
            <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2>)
        >, 
        s3, sr>
   ),
   !Pk( H, pkH ), !Pk( A1, pkA1 ), !Pk( A2, pkA2 ), !Pk( A3, pkA3 )
   ]
  --[
  Eq( verify(s1, <'root', H, A1, c1, tid>, pkH), true ),
  Eq( verify(s2, <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>,
             pkA1),
      true
  ),
  Eq( verify(s3,
             <'del', A2, A3, c3, 
              h(<<'root', H, A1, c1, tid>, s1, 
                 <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2>)
             >,
             pkA2),
      true
  ),
  Eq( verify(sr,
             <'req', a, $R, 
              h(<<'root', H, A1, c1, tid>, s1, 
                 <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2, 
                 <'del', A2, A3, c3, 
                  h(<<'root', H, A1, c1, tid>, s1, 
                     <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2>)
                 >, 
                 s3>)
             >,
             pkA3),
      true
  ),
  Check( c1, a ), Check( c2, a ), Check( c3, a ), Act( a )
  ]->
   [ Received( $R, A3, a, H, A1, c1, A2, c2, c3, tid ) ]

