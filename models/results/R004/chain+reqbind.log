                                                 sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                             >, 
                                             sign(<'del', $A1, $X.3, <'push', $repo>, 
                                                   h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                      sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                                  >,
                                                  ~k.1)
                                            >)
                                         >,
                                         ~k.2)
                               ) @ #vk.51 )
                          case Agent2_steered_delegation
                          solve( !KU( sign(<'req', <'push', $repo>, $R, 
