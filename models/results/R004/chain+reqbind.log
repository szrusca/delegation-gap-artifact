      solve( (c3 = <op, x>)  ∥
             (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c3 = <op.1, 'any'>)) )
        case case_1
        solve( !Ltk( $H, kH ) ▶₁ #j )
          case Register
