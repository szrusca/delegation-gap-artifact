rule (modulo E) Resource_accept_chain_only:
   [ Received( R, P, a, H, A1, c1, A2, c2, c3, tid ) ]
  --[ Accept( R, P, a, tid ), Chain( R, H, A1, c1, A2, c2, P, c3, tid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executable_static_task_conformant:
  exists-trace
  "∃ R a tid H A1 c1 A2 c2 A3 c3 #i #c #j #k.
    ((((((Accept( R, A3, a, tid ) @ #i) ∧
         (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c)) ∧
        (TaskStatic( tid ) @ #j)) ∧
       (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
      (¬(A1 = A2))) ∧
     (¬(A2 = A3))) ∧
    (¬(A1 = A3))"
/*
guarded formula characterizing all satisfying traces:
"∃ R a tid H A1 c1 A2 c2 A3 c3 #i #c #j #k.
  (Accept( R, A3, a, tid ) @ #i) ∧
  (Chain( R, H, A1, c1, A2, c2, A3, c3, tid ) @ #c) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  (¬(A1 = A2)) ∧ (¬(A2 = A3)) ∧ (¬(A1 = A3))"
*/
simplify
solve( Received( R, A3, a, H, A1, c1, A2, c2, c3, ~tid ) ▶₀ #i )
  case Resource_receive_bound
  solve( (c1.1 = a.1)  ∥ (∃ op x. (a.1 = <op, x>) ∧ (c1.1 = <op, 'any'>)) )
    case case_2
    solve( (c2.1 = <op, x>)  ∥
           (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c2.1 = <op.1, 'any'>)) )
      case case_1
      solve( (c3.1 = <op, x>)  ∥
             (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c3.1 = <op.1, 'any'>)) )
        case case_1
        solve( Received( $R, $X, a, H, A1, c1, A2, c2, c3, ~tid ) ▶₀ #c )
          case Resource_receive_bound
          solve( (c1 = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c1 = <op, 'any'>)) )
            case case_2
