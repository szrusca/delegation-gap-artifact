                                                              sign(<'root', $H, $A1, <'push', 'any'>, ~tid>,
                                                                   ~k)
                                                             >)
                                                          >,
                                                          ~k.1)
                                                    >)
                                                 >,
                                                 ~k.4)
                                       ) @ #vk.72 )
                                  case Agent2_steered_delegation
                                  solve( !KU( sign(<'req', <'push', x>, $R, 
                                                    h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                       sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k), 
                                                       <'del', $A1, $X.1, <'push', x>, 
                                                        h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                           sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)
                                                          >)
                                                       >, 
                                                       sign(<'del', $A1, $X.1, <'push', x>, 
                                                             h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                                sign(<'root', $H, $A1, <'push', 'any'>, ~tid>,
                                                                     ~k)
                                                               >)
                                                            >,
                                                            ~k.1), 
                                                       <'del', $X.1, $X, <'push', x>, 
