lemma witness_identity_collapse_guided:
  exists-trace
  "∃ R H a b t1 t2 c1 c2 D1 D2 d1 d2 #i #j #e1 #e2 #r1 #r2 #s1 #s2 #k1 #k2.
    ((((((((((Accept( R, H, 'DS', a, t1 ) @ #i) ∧
             (Accept( R, H, 'DS', b, t2 ) @ #j)) ∧
            (DSExec( H, d1, a, t1 ) @ #e1)) ∧
           (DSExec( H, d2, b, t2 ) @ #e2)) ∧
          (RootIssued( H, d1, c1, t1 ) @ #r1)) ∧
         (RootIssued( H, d2, c2, t2 ) @ #r2)) ∧
        (TaskStatic( t1 ) @ #s1)) ∧
       (TaskStatic( t2 ) @ #s2)) ∧
      (Key( D1, d1 ) @ #k1)) ∧
     (Key( D2, d2 ) @ #k2)) ∧
    (¬(D1 = D2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H a b t1 t2 c1 c2 D1 D2 d1 d2 #i #j #e1 #e2 #r1 #r2 #s1 #s2 #k1 #k2.
  (Accept( R, H, 'DS', a, t1 ) @ #i) ∧
  (Accept( R, H, 'DS', b, t2 ) @ #j) ∧
  (DSExec( H, d1, a, t1 ) @ #e1) ∧
  (DSExec( H, d2, b, t2 ) @ #e2) ∧
  (RootIssued( H, d1, c1, t1 ) @ #r1) ∧
  (RootIssued( H, d2, c2, t2 ) @ #r2) ∧
  (TaskStatic( t1 ) @ #s1) ∧
  (TaskStatic( t2 ) @ #s2) ∧
  (Key( D1, d1 ) @ #k1) ∧
  (Key( D2, d2 ) @ #k2)
 ∧
  ¬(D1 = D2)"
*/
simplify
solve( (c = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)) )
  case case_1
  solve( (c = b)  ∥ (∃ op x. (b = <op, x>) ∧ (c = <op, 'any'>)) )
    case case_1
    solve( UpCall( R.2, H, a, ~tid ) ▶₀ #i )
      case DS_exercises_with_vault_credential
      solve( (c = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)) )
        case case_1
        solve( UpCall( $R.2, $H, b, ~tid.1 ) ▶₀ #j )
          case DS_exercises_with_vault_credential
          solve( (c = b)  ∥ (∃ op x. (b = <op, x>) ∧ (c = <op, 'any'>)) )
            case case_1
            solve( !Ltk( 'DS', kDS ) ▶₁ #e1 )
              case Register
              solve( !Vault( $H, $R ) ▶₂ #e1 )
                case Human_links_vault_credential
                solve( !Ltk( 'DS', kDS ) ▶₁ #e2 )
                  case Register
                  solve( !Vault( $H, $R.1 ) ▶₂ #e2 )
                    case Human_links_vault_credential
                    solve( !TaskOf( ~tid, $H ) ▶₁ #r1 )
                      case Human_starts_static_task
                      solve( !Ltk( 'DS', kDS ) ▶₂ #r1 )
                        case Register
                        solve( !PreAuth( $H, pk(~k) ) ▶₃ #r1 )
                          case Human_preauthorizes_agent_did
                          solve( !Approved( $H, pk(~k), c1, ~tid ) ▶₄ #r1 )
                            case Human_approves_exact_operand
                            solve( !TaskOf( ~tid.1, $H ) ▶₁ #r2 )
                              case Human_starts_static_task
