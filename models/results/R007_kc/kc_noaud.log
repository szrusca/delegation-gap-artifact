lemma kc_witness_as_reveal_breaks_CONSENT_M:
  exists-trace
  "∃ M H C a tid #i #r.
    ((ToolExec( M, H, C, a, tid ) @ #i) ∧ (Reveal( 'AS' ) @ #r)) ∧
    (¬(∃ s #j. Consent( H, C, M, s, tid ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ M H C a tid #i #r.
  (ToolExec( M, H, C, a, tid ) @ #i) ∧ (Reveal( 'AS' ) @ #r)
 ∧
  ∀ s #j. (Consent( H, C, M, s, tid ) @ #j) ⇒ ⊥"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( !Pk( 'AS', pk(x) ) ▶₁ #i )
    case Register
    solve( !UpTok( $M, H, $R ) ▶₂ #i )
      case Human_authorizes_server_upstream
      solve( !Ltk( 'AS', k.1 ) ▶₀ #r )
        case Register
        solve( !KU( sign(<'at', $H, C, aud, a, cnf, tid>, ~k) ) @ #vk.22 )
          case c_sign
          solve( !KU( ~k ) @ #vk.24 )
            case Reveal_ltk
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

