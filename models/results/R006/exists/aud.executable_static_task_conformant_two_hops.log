lemma issued_scope_within_human_consent [use_induction, reuse]:
  all-traces
  "∀ H act aud sc cnf tid #i.
    (Issued( <'at', H, act, aud, sc, cnf, tid> ) @ #i) ⇒
    (∃ A1 c #j.
      (RootDelegated( H, A1, c, tid ) @ #j) ∧
      ((c = sc) ∨ (∃ op x. (sc = <op, x>) ∧ (c = <op, 'any'>))))"
/*
guarded formula characterizing all counter-examples:
"∃ H act aud sc cnf tid #i.
  (Issued( <'at', H, act, aud, sc, cnf, tid> ) @ #i)
 ∧
  ∀ A1 c #j.
   (RootDelegated( H, A1, c, tid ) @ #j)
  ⇒
   (¬(c = sc)) ∧ (∀ op x. (sc = <op, x>) ∧ (c = <op, 'any'>) ⇒ ⊥)"
*/
by sorry

lemma executable_static_task_conformant_two_hops:
  exists-trace
  "∃ R H A1 A2 a tid #i #j #k.
    ((((Accept( R, A2, a, tid ) @ #i) ∧ (Chain( R, H, A1, A2, tid ) @ #i)) ∧
      (TaskStatic( tid ) @ #j)) ∧
     (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
    (¬(A1 = A2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H A1 A2 a tid #i #j #k.
  (Accept( R, A2, a, tid ) @ #i) ∧
  (Chain( R, H, A1, A2, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  ¬(A1 = A2)"
*/
simplify
solve( (sc = a)  ∥ (∃ op x. (a = <op, x>) ∧ (sc = <op, 'any'>)) )
  case case_1
  solve( (c = <'push', 'any'>)  ∥
         (∃ op x. (<'push', 'any'> = <op, x>) ∧ (c = <op, 'any'>)) )
    case case_1
    solve( !Pk( 'AS', pk(x) ) ▶₁ #i )
      case Register
      solve( !Ltk( $H.1, kH ) ▶₁ #j )
        case Register
        solve( !Ltk( 'AS', kAS ) ▶₂ #j )
          case Register
          solve( Accept( $R, A2, a.1, ~tid ) @ #i )
            case Resource_accepts_depth2
            solve( Intends( H, ~tid, <'fixed', a> ) @ #k.2 )
              case Human_consents_static_task
              solve( (c = <'push', 'any'>)  ∥
                     (∃ op x. (<'push', 'any'> = <op, x>) ∧ (c = <op, 'any'>)) )
                case case_1
                solve( RootDelegated( $H, A1.2, <'push', 'any'>, ~tid ) @ #j.1 )
                  case Human_consents_static_task
                  solve( RootDelegated( $H, A1.4, <'push', 'any'>, ~tid ) @ #j.2 )
                    case Human_consents_static_task
                    solve( !KU( sign(<'at', $H, <'act', A2, 'act', A1, 'none'>, <'rs', $R>, 
                                      <'push', $repo>, cnf, ~tid>,
                                     ~k)
                           ) @ #vk.27 )
                      case AS_exchanges
                      solve( (sc = <'push', $repo>)  ∥
                             (∃ op x. (<'push', $repo> = <op, x>) ∧ (sc = <op, 'any'>)) )
                        case case_1
                        solve( (c = <'push', $repo>)  ∥
                               (∃ op x. (<'push', $repo> = <op, x>) ∧ (c = <op, 'any'>)) )
                          case case_2
