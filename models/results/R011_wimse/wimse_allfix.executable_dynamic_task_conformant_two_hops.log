rule (modulo E) Resource_accepts_vault_call:
   [ UpCall( R, H, did, a, tid ) ]
  --[ Accept( R, H, did, a, tid ), Served( R, did, a, tid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executable_static_task_conformant_two_hops:
  exists-trace
  "∃ R H a tid D1 D2 d1 d2 #i #e #c #j #k #k1 #k2.
    (((((((Accept( R, H, d2, a, tid ) @ #i) ∧
          (DSExec( H, d2, a, tid ) @ #e)) ∧
         (ChildIssued( d1, d2, tid ) @ #c)) ∧
        (TaskStatic( tid ) @ #j)) ∧
       (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
      (Key( D1, d1 ) @ #k1)) ∧
     (Key( D2, d2 ) @ #k2)) ∧
    (¬(D1 = D2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H a tid D1 D2 d1 d2 #i #e #c #j #k #k1 #k2.
  (Accept( R, H, d2, a, tid ) @ #i) ∧
  (DSExec( H, d2, a, tid ) @ #e) ∧
  (ChildIssued( d1, d2, tid ) @ #c) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k) ∧
  (Key( D1, d1 ) @ #k1) ∧
  (Key( D2, d2 ) @ #k2)
 ∧
  ¬(D1 = D2)"
*/
by sorry

lemma executable_dynamic_task_conformant_two_hops:
  exists-trace
  "∃ R H op v S tid D1 D2 d1 d2 #i #e #c #k #l #k1 #k2.
    (((((((Accept( R, H, d2, <op, v>, tid ) @ #i) ∧
          (DSExec( H, d2, <op, v>, tid ) @ #e)) ∧
         (ChildIssued( d1, d2, tid ) @ #c)) ∧
        (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
       (Produced( S, tid, v ) @ #l)) ∧
      (Key( D1, d1 ) @ #k1)) ∧
     (Key( D2, d2 ) @ #k2)) ∧
    (¬(D1 = D2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H op v S tid D1 D2 d1 d2 #i #e #c #k #l #k1 #k2.
  (Accept( R, H, d2, <op, v>, tid ) @ #i) ∧
  (DSExec( H, d2, <op, v>, tid ) @ #e) ∧
  (ChildIssued( d1, d2, tid ) @ #c) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l) ∧
  (Key( D1, d1 ) @ #k1) ∧
  (Key( D2, d2 ) @ #k2)
 ∧
  ¬(D1 = D2)"
*/
simplify
solve( (c1 = c2)  ∥ (∃ op x. (c2 = <op, x>) ∧ (c1 = <op, 'any'>)) )
  case case_1
  solve( UpCall( R, H.1, pk(~k.1), <op, $v>, tid ) ▶₀ #i )
    case DS_exercises_capsule_hole_provenance
    solve( (c.1 = <op, $v>)  ∥
           (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c.1 = <op.1, 'any'>)) )
      case case_1
      solve( !Ltk( 'DS', kDS ) ▶₁ #c )
        case Register
        solve( !PreAuth( H, pk(~k.2) ) ▶₂ #c )
          case Human_preauthorizes_agent_did
          solve( !Ltk( $Src, ks ) ▶₁ #l )
            case Register
            solve( DSExec( $H.1, pk(~k.2), <op, $v>, tid ) @ #e )
              case DS_exercises_capsule_hole_provenance
              solve( (c.1 = <op, $v>)  ∥
                     (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c.1 = <op.1, 'any'>)) )
                case case_1
                solve( !Ltk( 'DS', kDS ) ▶₁ #e )
                  case Register
                  solve( !Vault( $H.1, $R ) ▶₂ #e )
                    case Human_links_vault_credential
                    solve( !Pk( $H.1, pk(x) ) ▶₄ #e )
                      case Register
                      solve( !Pk( S, pk(x) ) ▶₆ #e )
                        case Register
                        solve( Intends( $H.1, tid, <'hole', op, $Src> ) @ #k.8 )
                          case Human_starts_dynamic_task
                          solve( !Ltk( $H.1, kH ) ▶₁ #k.8 )
                            case Register
                            solve( !KU( sign(<'dt', $H, pk(~k), c1, ~tid, 'root'>, ~k.1) ) @ #vk.46 )
                              case DS_issues_root_dt
                              solve( (<'push', 'any'> = c1)  ∥
                                     (∃ op x. (c1 = <op, x>) ∧ (<'push', 'any'> = <op, 'any'>)) )
                                case case_1
                                solve( !KU( sign(<'sreq', 
                                                  h(<'dt', $H, pk(~k), <'push', 'any'>, ~tid, 'root'>), 
                                                  pk(~k.2), 'push', 'any'>,
                                                 ~k)
                                       ) @ #vk.52 )
                                  case Agent_requests_subdelegation
                                  solve( !KU( sign(<'dt', $H, pk(~k.2), <'push', $v>, ~tid, par.1>, ~k.1)
                                         ) @ #vk.65 )
                                    case DS_issues_root_dt
                                    solve( (<'push', 'any'> = <'push', $v>)  ∥
                                           (∃ op x.
                                             (<'push', $v> = <op, x>) ∧ (<'push', 'any'> = <op, 'any'>)) )
                                      case case_2
                                      solve( !KU( sign(<'dpop', <'push', $v>, $R.1, 
                                                        h(<'dt', $H, pk(~k.2), <'push', $v>, ~tid, 'root'>)>,
                                                       ~k.2)
                                             ) @ #vk.75 )
                                        case Agent_exercises
                                        solve( !KU( sign(<'cap', $H, ~tid, 'hole', 'push', $X.3>, ~k.3)
                                               ) @ #vk.82 )
                                          case Human_starts_dynamic_task
                                          solve( !KU( sign(<'dt', $H, pk(~k.2), <'push', $v>, ~tid, par>,
                                                           ~k.1)
                                                 ) @ #vk.86 )
                                            case DS_issues_root_dt
                                            solve( !KU( sign(<'dpop', <'push', $v>, $R, 
                                                              h(<'dt', $H, pk(~k.2), <'push', $v>, ~tid, 
                                                                 'root'>)
                                                             >,
                                                             ~k.2)
                                                   ) @ #vk.81 )
                                              case Agent_exercises
                                              solve( !KU( sign(<'cap', $H, ~tid, 'hole', 'push', $X>, ~k.3)
                                                     ) @ #vk.85 )
                                                case Human_starts_dynamic_task
                                                solve( !KU( sign(<'rreq', $H, pk(~k), <'push', 'any'>, ~tid>,
                                                                 ~k)
                                                       ) @ #vk.76 )
                                                  case Agent_requests_root_dt
                                                  solve( !KU( sign(<'rreq', $H, pk(~k.2), <'push', $v>, ~tid>,
                                                                   ~k.2)
                                                         ) @ #vk.80 )
                                                    case Agent_requests_root_dt
                                                    solve( !KU( ~tid ) @ #vk.54 )
                                                      case Human_starts_dynamic_task_case_1
                                                      solve( !KU( sign(<'prov', $Src, ~tid, $v>, ~k.4)
                                                             ) @ #vk.77 )
                                                        case Source_produces
                                                        solve( !KU( pk(~k) ) @ #vk.52 )
                                                          case Agent_requests_root_dt
                                                          solve( !KU( pk(~k.2) ) @ #vk.64 )
                                                            case Agent_requests_root_dt
                                                            SOLVED // trace found
                                                          qed
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma witness_splice_child_without_parent_request:
  exists-trace
  "∃ D1 d1 d2 tid #c #k.
    ((ChildIssued( d1, d2, tid ) @ #c) ∧ (Key( D1, d1 ) @ #k)) ∧
    (¬(∃ #j. SubDelegated( d1, d2, tid ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ D1 d1 d2 tid #c #k.
  (ChildIssued( d1, d2, tid ) @ #c) ∧ (Key( D1, d1 ) @ #k)
 ∧
  ∀ #j. (SubDelegated( d1, d2, tid ) @ #j) ⇒ ⊥"
*/
by sorry

lemma witness_exercise_by_unregistered_did:
  exists-trace
  "∃ H did a tid #e.
    (DSExec( H, did, a, tid ) @ #e) ∧ (¬(∃ D #k. Key( D, did ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ H did a tid #e.
  (DSExec( H, did, a, tid ) @ #e) ∧ ∀ D #k. (Key( D, did ) @ #k) ⇒ ⊥"
*/
by sorry

lemma witness_identity_collapse_at_resource:
  exists-trace
  "∃ R H L a b t1 t2 d1 d2 #i #j.
    ((((Accept( R, H, L, a, t1 ) @ #i) ∧ (Served( R, d1, a, t1 ) @ #i)) ∧
      (Accept( R, H, L, b, t2 ) @ #j)) ∧
     (Served( R, d2, b, t2 ) @ #j)) ∧
    (¬(d1 = d2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L a b t1 t2 d1 d2 #i #j.
  (Accept( R, H, L, a, t1 ) @ #i) ∧
  (Served( R, d1, a, t1 ) @ #i) ∧
  (Accept( R, H, L, b, t2 ) @ #j) ∧
  (Served( R, d2, b, t2 ) @ #j)
 ∧
  ¬(d1 = d2)"
*/
