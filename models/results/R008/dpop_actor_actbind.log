lemma executable_static_task_conformant:
  exists-trace
  "∃ R H K Y a tid #i #j #k #q.
    ((((Accept( R, H, K, Y, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
      (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
     (Request( Y, a, tid ) @ #q)) ∧
    (¬(K = Y))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y a tid #i #j #k #q.
  (Accept( R, H, K, Y, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k) ∧
  (Request( Y, a, tid ) @ #q)
 ∧
  ¬(K = Y)"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_2
  solve( !Pk( 'AS', pk(x.2) ) ▶₁ #i )
    case Register
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( $X, kX ) ▶₂ #q )
        case Register
        solve( Intends( H, ~tid, <'fixed', op, x> ) @ #k.3 )
          case Human_consents_static
          solve( !KU( sign(<'obo', $H, K, $X, <'push', 'any'>, pk(x), ~tid>, ~k)
                 ) @ #vk.29 )
            case AS_token_endpoint
            solve( !KU( sign(<'dpop', <'push', $repo>, $R, 
                              h(<<'obo', $H, $K, $X, <'push', 'any'>, pk(~k), ~tid>, 
                                 sign(<'obo', $H, $K, $X, <'push', 'any'>, pk(~k), ~tid>, ~k.1)>)
                             >,
                             ~k)
                   ) @ #vk.32 )
              case Agent_sends_request
              solve( !KU( sign(<'actor', $X>, ~k.1) ) @ #vk.50 )
                case Actor_joins_flow
                solve( !KU( sign(<'join', $X, ~tid>, ~k) ) @ #vk.52 )
                  case Actor_joins_flow
                  solve( !KU( ~tid ) @ #vk.34 )
                    case Human_consents_static
                    solve( !KU( pk(~k) ) @ #vk.35 )
                      case AS_token_endpoint_case_1
                      solve( !KU( sign(<'join', $X, ~tid.2>, ~k) ) @ #vk.63 )
                        case Actor_joins_flow
                        solve( !KU( ~tid.2 ) @ #vk.62 )
                          case Human_consents_static
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R H K Y op v S tid #i #k #l #q.
    ((((Accept( R, H, K, Y, <op, v>, tid ) @ #i) ∧
       (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
      (Produced( S, tid, v ) @ #l)) ∧
     (Request( Y, <op, v>, tid ) @ #q)) ∧
    (¬(K = Y))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y op v S tid #i #k #l #q.
  (Accept( R, H, K, Y, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l) ∧
  (Request( Y, <op, v>, tid ) @ #q)
 ∧
  ¬(K = Y)"
*/
simplify
solve( (s = <op, $v>)  ∥
       (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (s = <op.1, 'any'>)) )
  case case_2
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !TaskOpen( tid, $Src ) ▶₀ #l )
      case Human_consents_dynamic
      solve( !Ltk( $Src, ks ) ▶₁ #l )
        case Register
        solve( !Ltk( $X, kX ) ▶₂ #q )
          case Register
          solve( Intends( H, ~tid, <'hole', op, $Src> ) @ #k.4 )
            case Human_consents_dynamic
            solve( !KU( sign(<'obo', $H, K, $X, <'push', 'any'>, pk(x), ~tid>, ~k)
                   ) @ #vk.29 )
              case AS_token_endpoint
              solve( !KU( sign(<'dpop', <'push', $v>, $R, 
                                h(<<'obo', $H, $K, $X, <'push', 'any'>, pk(~k), ~tid>, 
                                   sign(<'obo', $H, $K, $X, <'push', 'any'>, pk(~k), ~tid>, ~k.1)>)
                               >,
                               ~k)
                     ) @ #vk.32 )
                case Agent_sends_request
                solve( !KU( sign(<'actor', $X>, ~k.1) ) @ #vk.50 )
                  case Actor_joins_flow
                  solve( !KU( sign(<'join', $X, ~tid>, ~k) ) @ #vk.52 )
                    case Actor_joins_flow
                    solve( !KU( ~tid ) @ #vk.34 )
                      case Human_consents_dynamic
                      solve( !KU( pk(~k) ) @ #vk.35 )
                        case AS_token_endpoint_case_1
                        solve( !KU( sign(<'join', $X, ~tid.2>, ~k) ) @ #vk.63 )
                          case Actor_joins_flow
                          solve( !KU( ~tid.2 ) @ #vk.62 )
                            case Human_consents_static
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma witness_client_acts_logged_as_actor:
  exists-trace
  "∃ R H K Y a tid #i #q.
    (((Accept( R, H, K, Y, a, tid ) @ #i) ∧ (Request( K, a, tid ) @ #q)) ∧
     (¬(K = Y))) ∧
    (¬(∃ #p. Request( Y, a, tid ) @ #p))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y a tid #i #q.
  (Accept( R, H, K, Y, a, tid ) @ #i) ∧ (Request( K, a, tid ) @ #q)
 ∧
  (¬(K = Y)) ∧ (∀ #p. (Request( Y, a, tid ) @ #p) ⇒ ⊥)"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !Ltk( $X, kX ) ▶₂ #q )
      case Register
      solve( !KU( sign(<'obo', H, $X, Y, a, pk(x), tid>, ~k) ) @ #vk.27 )
        case AS_token_endpoint_case_1
        by contradiction /* from formulas */
      next
        case AS_token_endpoint_case_2
        by contradiction /* from formulas */
      next
        case c_sign
        by solve( !KU( ~k ) @ #vk.37 )
      qed
    qed
  qed
next
  case case_2
  solve( !Pk( 'AS', pk(x.2) ) ▶₁ #i )
    case Register
    solve( !Ltk( $X, kX ) ▶₂ #q )
      case Register
      solve( !KU( sign(<'obo', H, $X, Y, <op, 'any'>, pk(x.1), tid>, ~k)
             ) @ #vk.28 )
        case AS_token_endpoint_case_1
        solve( !KU( sign(<'dpop', <'push', x>, $R, 
                          h(<<'obo', $H, $X, $Y, <'push', 'any'>, pk(~k), ~tid>, 
                             sign(<'obo', $H, $X, $Y, <'push', 'any'>, pk(~k), ~tid>, ~k.1)>)
                         >,
                         ~k)
               ) @ #vk.32 )
          case Agent_sends_request
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~k ) @ #vk.57 )
        qed
      next
        case AS_token_endpoint_case_2
        solve( !KU( sign(<'dpop', <'push', x>, $R, 
                          h(<<'obo', $H, $X, $Y, <'push', 'any'>, pk(~k), ~tid>, 
                             sign(<'obo', $H, $X, $Y, <'push', 'any'>, pk(~k), ~tid>, ~k.1)>)
                         >,
                         ~k)
               ) @ #vk.32 )
          case Agent_sends_request
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~k ) @ #vk.57 )
        qed
      next
        case c_sign
        by solve( !KU( ~k ) @ #vk.41 )
      qed
    qed
  qed
qed

