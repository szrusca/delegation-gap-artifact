rule (modulo E) Register:
   [ Fr( ~k ) ]
  --[ Register( $X ), Key( $X, pk(~k) ) ]->
   [ !Ltk( $X, ~k ), !Pk( $X, pk(~k) ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_links_vault_credential:
   [ !Ltk( $H, kH ) ] --[ VaultLinked( $H, $R ) ]-> [ !Vault( $H, $R ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_starts_static_task:
   [ Fr( ~tid ), !Ltk( $H, kH ) ]
  --[ Intends( $H, ~tid, <'fixed', 'push', $repo> ), TaskStatic( ~tid ) ]->
   [
   Out( <~tid, $H> ), !TaskOf( ~tid, $H ),
   !TaskFixed( ~tid, $H, <'push', $repo> ),
   Out( <<'cap', $H, ~tid, 'fixed', 'push', $repo>, 
         sign(<'cap', $H, ~tid, 'fixed', 'push', $repo>, kH)>
   )
   ]

  /* has exactly the trivial AC variant */

