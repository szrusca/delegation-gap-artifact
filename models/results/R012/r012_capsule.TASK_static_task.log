  all-traces
  "∀ R H L a tid #i #j.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ⇒
    (∃ #k. Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all counter-examples:
"∃ R H L a tid #i #j.
  (Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)
 ∧
  ∀ #k. (Intends( H, tid, <'fixed', a> ) @ #k) ⇒ ⊥"
*/
simplify
solve( UpCall( R, H, did, a, ~tid ) ▶₀ #i )
  case DS_exercises_capsule_fixed
  solve( (c = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)) )
    case case_1
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !KU( sign(<'dt', $H, pk(x), a, ~tid, par>, ~k.1) ) @ #vk.22 )
