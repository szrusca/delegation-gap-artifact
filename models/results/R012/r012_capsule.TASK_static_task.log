*/
by sorry

lemma NOESC_exercise_within_human_authorization:
  all-traces
  "∀ H did a tid #e.
    (DSExec( H, did, a, tid ) @ #e) ⇒
    ((∃ c #j.
       (PolicySet( H, c ) @ #j) ∧
       ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))) ∨
     (∃ d c #j.
       (CibaApproved( H, d, c, tid ) @ #j) ∧
       ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))))"
/*
guarded formula characterizing all counter-examples:
"∃ H did a tid #e.
  (DSExec( H, did, a, tid ) @ #e)
 ∧
  (∀ c #j.
    (PolicySet( H, c ) @ #j)
   ⇒
    (¬(c = a)) ∧ (∀ op x. (a = <op, x>) ∧ (c = <op, 'any'>) ⇒ ⊥)) ∧
  (∀ d c #j.
    (CibaApproved( H, d, c, tid ) @ #j)
   ⇒
    (¬(c = a)) ∧ (∀ op x. (a = <op, x>) ∧ (c = <op, 'any'>) ⇒ ⊥))"
*/
by sorry

