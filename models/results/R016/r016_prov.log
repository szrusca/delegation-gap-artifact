lemma executable_static_task_conformant:
  exists-trace
  "∃ R H L a tid #i #j #k.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L a tid #i #j #k.
  (Accept( R, H, L, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( UpReq( L, R, H, C, a, ~tid ) ▶₀ #i )
  case Server_executes_with_any_provenance
  solve( (s = <op, v>)  ∥
         (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (s = <op.1, 'any'>)) )
    case case_2
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( 'AS', kAS ) ▶₂ #j )
        case Register
        solve( Intends( $H, ~tid, <'fixed', op, v> ) @ #k.5 )
          case Human_consents_static
          solve( !KU( sign(<'at', $H, C, $M, <'push', 'any'>, cnf, ~tid>, ~k.1)
                 ) @ #vk.28 )
            case Human_consents_static
            solve( !KU( sign(<'prov', $X, ~tid, $repo>, ~k.2) ) @ #vk.32 )
              case Source_produces
              solve( !KU( ~tid ) @ #vk.29 )
                case Human_consents_static
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

