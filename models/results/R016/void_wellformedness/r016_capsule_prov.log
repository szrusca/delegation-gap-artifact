rule (modulo E) Resource_accepts_upstream_call:
   [ UpReq( M, R, H, C, a, tid ) ]
  --[ Accept( R, H, M, a, tid ), ViaServer( R, M, a, tid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executable_static_task_conformant:
  exists-trace
  "∃ R H L a tid #i #j #k.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L a tid #i #j #k.
  (Accept( R, H, L, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( UpReq( L, R, H, C, a, ~tid ) ▶₀ #i )
  case Server_executes_capsule_fixed
  solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_2
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( 'AS', kAS ) ▶₂ #j )
        case Register
        solve( Intends( $H, ~tid, <'fixed', op, x> ) @ #k.4 )
          case Human_consents_static
          solve( !KU( sign(<'at', $H, C, $M, <'push', 'any'>, cnf, ~tid>, ~k.1)
                 ) @ #vk.27 )
            case Human_consents_static
            solve( !KU( ~tid ) @ #vk.26 )
              case Human_consents_static_case_1
              solve( !KU( sign(<'cap', $H, ~tid, 'fixed', 'push', $repo>, ~k)
                     ) @ #vk.31 )
                case Human_consents_static
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R H L op v S tid #i #k #l.
    ((Accept( R, H, L, <op, v>, tid ) @ #i) ∧
     (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
    (Produced( S, tid, v ) @ #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L op v S tid #i #k #l.
  (Accept( R, H, L, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l)"
*/
simplify
solve( UpReq( L, R, H, C, <op, $v>, tid ) ▶₀ #i )
  case Server_executes_capsule_hole_provenance
  solve( (s = <op, $v>)  ∥
         (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (s = <op.1, 'any'>)) )
    case case_2
    solve( !Ltk( $Src, ks ) ▶₁ #l )
      case Register
      solve( Intends( $H, tid, <'hole', op, $Src> ) @ #k.4 )
        case Human_consents_dynamic
        solve( !Ltk( $H, kH ) ▶₁ #k.4 )
          case Register
          solve( !Ltk( 'AS', kAS ) ▶₂ #k.4 )
            case Register
            solve( !KU( sign(<'at', $H, C, $M, <'push', 'any'>, cnf, ~tid>, ~k.1)
                   ) @ #vk.34 )
              case Human_consents_dynamic
              solve( !KU( sign(<'cap', $H, ~tid, 'hole', 'push', $X>, ~k.2)
                     ) @ #vk.39 )
                case Human_consents_dynamic
                solve( !KU( ~tid ) @ #vk.3 )
                  case Human_consents_dynamic_case_1
                  solve( !KU( sign(<'prov', $Src, ~tid, $v>, ~k) ) @ #vk.41 )
                    case Source_produces
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma witness_cross_server_token_replay:
  exists-trace
  "∃ M M2 H C a s tid #i #j.
    ((ToolExec( M, H, C, a, tid ) @ #i) ∧
     (Consent( H, C, M2, s, tid ) @ #j)) ∧
    (¬(M = M2))"
/*
guarded formula characterizing all satisfying traces:
"∃ M M2 H C a s tid #i #j.
  (ToolExec( M, H, C, a, tid ) @ #i) ∧ (Consent( H, C, M2, s, tid ) @ #j)
 ∧
  ¬(M = M2)"
*/
simplify
solve( ToolExec( M, H, C, a, tid ) @ #i )
  case Server_executes_capsule_fixed
  solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_1
    solve( !Pk( 'AS', pk(x) ) ▶₁ #i )
      case Register
      solve( !UpTok( $M, H, $R ) ▶₂ #i )
        case Human_authorizes_server_upstream
        solve( !Pk( $H, pk(x) ) ▶₄ #i )
          case Register
          solve( Consent( $H, C, M2, s, tid ) @ #j )
            case Human_consents_dynamic
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #j )
                case Register
                solve( !KU( sign(<'at', $H, $C, $M, a, cnf, ~tid>, ~k) ) @ #vk.26 )
                  case Human_consents_dynamic
                  by contradiction /* from formulas */
                next
                  case c_sign
                  by solve( !KU( ~k ) @ #vk.31 )
                qed
              qed
