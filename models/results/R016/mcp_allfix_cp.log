rule (modulo E) Resource_accepts_upstream_call:
   [ UpReq( M, R, H, C, a, tid ) ]
  --[ Accept( R, H, C, a, tid ), ViaServer( R, M, a, tid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executable_static_task_conformant:
  exists-trace
  "∃ R H L a tid #i #j #k.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L a tid #i #j #k.
  (Accept( R, H, L, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( UpReq( M, R, H, L, a, ~tid ) ▶₀ #i )
  case Server_executes_capsule_fixed
  solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_1
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( 'AS', kAS ) ▶₂ #j )
        case Register
        solve( !Pk( $C, pkC ) ▶₃ #j )
          case Register
          solve( Intends( $H, ~tid, <'fixed', a> ) @ #k.4 )
            case Human_consents_static
            solve( !KU( sign(<'at', $H, L, $M, <'push', $repo>, pk(x), ~tid>, ~k.1)
                   ) @ #vk.26 )
              case Human_consents_static
              solve( !KU( sign(<'dpop', <'push', $repo>, $M, 
                                h(<<'at', $H, $C, $M, <'push', $repo>, pk(~k.2), ~tid>, 
                                   sign(<'at', $H, $C, $M, <'push', $repo>, pk(~k.2), ~tid>, ~k.1)>)
                               >,
                               ~k.2)
                     ) @ #vk.27 )
                case Agent_calls_tool
                solve( !KU( ~tid ) @ #vk.30 )
                  case Human_consents_static_case_1
                  solve( !KU( sign(<'cap', $H, ~tid, 'fixed', 'push', $repo>, ~k)
                         ) @ #vk.33 )
                    case Human_consents_static
                    solve( !KU( pk(~k.2) ) @ #vk.31 )
                      case Human_consents_dynamic
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R H L op v S tid #i #k #l.
    ((Accept( R, H, L, <op, v>, tid ) @ #i) ∧
     (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
    (Produced( S, tid, v ) @ #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L op v S tid #i #k #l.
  (Accept( R, H, L, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l)"
*/
simplify
solve( UpReq( M, R, H, L, <op, $v>, tid ) ▶₀ #i )
  case Server_executes_capsule_hole_provenance
  solve( (s = <op, $v>)  ∥
         (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (s = <op.1, 'any'>)) )
    case case_1
    solve( !Ltk( $Src, ks ) ▶₁ #l )
      case Register
      solve( Intends( $H, tid, <'hole', op, $Src> ) @ #k.4 )
        case Human_consents_dynamic
        solve( !Ltk( $H, kH ) ▶₁ #k.4 )
          case Register
          solve( !Ltk( 'AS', kAS ) ▶₂ #k.4 )
            case Register
            solve( !Pk( $C, pkC ) ▶₃ #k.4 )
              case Register
              solve( !KU( sign(<'at', $H, L, $M, <'push', $v>, pk(x), ~tid>, ~k.1)
                     ) @ #vk.33 )
                case Human_consents_dynamic
                solve( !KU( sign(<'dpop', <'push', $v>, $M, 
                                  h(<<'at', $H, $C, $M, <'push', $v>, pk(~k.1), ~tid>, 
                                     sign(<'at', $H, $C, $M, <'push', $v>, pk(~k.1), ~tid>, ~k.2)>)
                                 >,
                                 ~k.1)
                       ) @ #vk.34 )
                  case Agent_calls_tool
                  solve( !KU( sign(<'cap', $H, ~tid, 'hole', 'push', $X>, ~k.3)
                         ) @ #vk.41 )
                    case Human_consents_dynamic
                    solve( !KU( ~tid ) @ #vk.6 )
                      case Human_consents_dynamic_case_1
                      solve( !KU( sign(<'prov', $Src, ~tid, $v>, ~k) ) @ #vk.43 )
                        case Source_produces
                        solve( !KU( pk(~k.1) ) @ #vk.39 )
                          case Human_consents_dynamic
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma witness_cross_server_token_replay:
  exists-trace
  "∃ M M2 H C a s tid #i #j.
    ((ToolExec( M, H, C, a, tid ) @ #i) ∧
     (Consent( H, C, M2, s, tid ) @ #j)) ∧
    (¬(M = M2))"
/*
guarded formula characterizing all satisfying traces:
"∃ M M2 H C a s tid #i #j.
  (ToolExec( M, H, C, a, tid ) @ #i) ∧ (Consent( H, C, M2, s, tid ) @ #j)
 ∧
  ¬(M = M2)"
*/
simplify
solve( ToolExec( M, H, C, a, tid ) @ #i )
  case Server_executes_capsule_fixed
  solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_1
    solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
      case Register
      solve( !UpTok( $M, H, $R ) ▶₂ #i )
        case Human_authorizes_server_upstream
        solve( !Pk( $H, pk(x.1) ) ▶₄ #i )
          case Register
          solve( Consent( $H, C, M2, s, tid ) @ #j )
            case Human_consents_dynamic
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #j )
                case Register
                solve( !Pk( $C, pkC ) ▶₃ #j )
                  case Register
                  solve( !KU( sign(<'at', $H, $C, $M, a, pk(x), ~tid>, ~k) ) @ #vk.26 )
                    case Human_consents_dynamic
                    by contradiction /* from formulas */
                  next
                    case c_sign
                    by solve( !KU( ~k ) @ #vk.32 )
                  qed
                qed
              qed
            qed
          next
            case Human_consents_other
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #j )
                case Register
                solve( !Pk( $C, pkC ) ▶₃ #j )
                  case Register
                  solve( !KU( sign(<'at', $H, $C, $M, a, pk(x), ~tid>, ~k) ) @ #vk.26 )
                    case Human_consents_other
                    by contradiction /* from formulas */
                  next
                    case c_sign
                    by solve( !KU( ~k ) @ #vk.31 )
                  qed
                qed
              qed
            qed
          next
            case Human_consents_static
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #j )
                case Register
                solve( !Pk( $C, pkC ) ▶₃ #j )
                  case Register
                  solve( !KU( sign(<'at', $H, $C, $M, a, pk(x), ~tid>, ~k) ) @ #vk.26 )
                    case Human_consents_static
                    by contradiction /* from formulas */
                  next
                    case c_sign
                    by solve( !KU( ~k ) @ #vk.31 )
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case case_2
    solve( !Pk( 'AS', pk(x.2) ) ▶₁ #i )
      case Register
      solve( !UpTok( $M, H, $R ) ▶₂ #i )
        case Human_authorizes_server_upstream
        solve( !Pk( $H, pk(x.2) ) ▶₄ #i )
          case Register
          solve( Consent( $H, C, M2, s, tid ) @ #j )
            case Human_consents_dynamic
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #j )
                case Register
                solve( !Pk( $C, pkC ) ▶₃ #j )
                  case Register
                  solve( !KU( sign(<'at', $H, $C, $M, <op, 'any'>, pk(x.1), ~tid>, ~k)
                         ) @ #vk.27 )
                    case Human_consents_dynamic
                    by contradiction /* from formulas */
                  next
                    case c_sign
                    by solve( !KU( ~k ) @ #vk.36 )
                  qed
                qed
              qed
            qed
          next
            case Human_consents_other
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #j )
                case Register
                solve( !Pk( $C, pkC ) ▶₃ #j )
                  case Register
                  solve( !KU( sign(<'at', $H, $C, $M, <op, 'any'>, pk(x.1), ~tid>, ~k)
