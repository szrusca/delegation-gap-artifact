          next
            case Human_consents_other
            by contradiction /* from formulas */
          next
            case Human_consents_static
            by contradiction /* from formulas */
          next
            case c_sign
            by solve( !KU( ~k ) @ #vk.35 )
          qed
        qed
      qed
    qed
  qed
next
