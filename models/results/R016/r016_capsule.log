lemma witness_identity_collapse:
  exists-trace
  "∃ R H L M a b t1 t2 C1 C2 #i #j #k #l.
    ((((Accept( R, H, L, a, t1 ) @ #i) ∧ (Accept( R, H, L, b, t2 ) @ #j)) ∧
      (ToolExec( M, H, C1, a, t1 ) @ #k)) ∧
     (ToolExec( M, H, C2, b, t2 ) @ #l)) ∧
    (¬(C1 = C2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L M a b t1 t2 C1 C2 #i #j #k #l.
  (Accept( R, H, L, a, t1 ) @ #i) ∧
  (Accept( R, H, L, b, t2 ) @ #j) ∧
  (ToolExec( M, H, C1, a, t1 ) @ #k) ∧
  (ToolExec( M, H, C2, b, t2 ) @ #l)
 ∧
  ¬(C1 = C2)"
*/
simplify
solve( UpReq( L, R, H, C, a, t1 ) ▶₀ #i )
  case Server_executes_capsule_fixed
  solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_2
    solve( UpReq( $M, $R, $H, C.1, b, t2 ) ▶₀ #j )
      case Server_executes_capsule_fixed
      solve( (s = b)  ∥ (∃ op x. (b = <op, x>) ∧ (s = <op, 'any'>)) )
        case case_2
        solve( ToolExec( M.1, $H, C1, <op, x>, t1 ) @ #k.2 )
          case Server_executes_capsule_fixed
          solve( (s = <op, x>)  ∥
                 (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (s = <op.1, 'any'>)) )
            case case_2
            solve( !Pk( 'AS', pk(x.2) ) ▶₁ #k.2 )
              case Register
              solve( !UpTok( $M.1, $H, $R.1 ) ▶₂ #k.2 )
                case Human_authorizes_server_upstream
                solve( !Pk( $H, pk(x.2) ) ▶₄ #k.2 )
                  case Register
                  solve( ToolExec( $M.1, $H, C2, <op.1, x.1>, t2 ) @ #l )
                    case Server_executes_capsule_fixed
                    solve( (s = <op.1, x.1>)  ∥
                           (∃ op.2 x.2. (<op.1, x.1> = <op.2, x.2>) ∧ (s = <op.2, 'any'>)) )
                      case case_2
                      solve( !Pk( 'AS', pk(x.2) ) ▶₁ #l )
                        case Register
                        solve( !UpTok( $M.1, $H, $R.1 ) ▶₂ #l )
                          case Human_authorizes_server_upstream
                          solve( !Pk( $H, pk(x.2) ) ▶₄ #l )
                            case Register
                            solve( !KU( sign(<'at', $H, C, $M, <op, 'any'>, cnf.1, t1>, ~k)
                                   ) @ #vk.57 )
                              case Human_consents_static
                              solve( !KU( sign(<'cap', $H, ~tid, 'fixed', 'push', x>, ~k.1)
                                     ) @ #vk.63 )
                                case Human_consents_static
                                solve( !KU( sign(<'at', $H, C.1, $M, <op, 'any'>, cnf.2, t2>, ~k)
                                       ) @ #vk.79 )
                                  case Human_consents_static
                                  solve( !KU( sign(<'cap', $H, ~tid.1, 'fixed', 'push', x>, ~k.1)
                                         ) @ #vk.79 )
                                    case Human_consents_static
                                    solve( !KU( sign(<'at', $H, C1, $M.1, <'push', 'any'>, cnf.1, ~tid>, ~k)
                                           ) @ #vk.86 )
                                      case Human_consents_static
                                      solve( !KU( sign(<'at', $H, C2, $M, <'push', 'any'>, cnf, ~tid.1>, ~k)
                                             ) @ #vk.82 )
                                        case Human_consents_static
                                        solve( !KU( ~tid ) @ #vk.57 )
                                          case Human_consents_static_case_1
                                          solve( !KU( ~tid.1 ) @ #vk.68 )
                                            case Human_consents_static_case_1
                                            SOLVED // trace found
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma CONSENT_M_server_acts_only_on_its_own_grant:
  all-traces
  "∀ M H C a tid #i.
    (ToolExec( M, H, C, a, tid ) @ #i) ⇒
    (∃ s #j. Consent( H, C, M, s, tid ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ M H C a tid #i.
  (ToolExec( M, H, C, a, tid ) @ #i)
 ∧
  ∀ s #j. (Consent( H, C, M, s, tid ) @ #j) ⇒ ⊥"
*/
simplify
solve( ToolExec( M, H, C, a, tid ) @ #i )
  case Server_executes_capsule_fixed
