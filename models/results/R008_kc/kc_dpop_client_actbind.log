lemma kc_witness_as_reveal_breaks_AUTH:
  exists-trace
  "∃ R H K Y a tid #i #r.
    ((Accept( R, H, K, Y, a, tid ) @ #i) ∧ (Reveal( 'AS' ) @ #r)) ∧
    (¬(∃ s #j. Consent( H, K, Y, s, tid ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y a tid #i #r.
  (Accept( R, H, K, Y, a, tid ) @ #i) ∧ (Reveal( 'AS' ) @ #r)
 ∧
  ∀ s #j. (Consent( H, K, Y, s, tid ) @ #j) ⇒ ⊥"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !Ltk( 'AS', k.1 ) ▶₀ #r )
      case Register
      solve( !KU( sign(<'obo', H, K, Y, a, pk(x), tid>, ~k) ) @ #vk.20 )
        case c_sign
        solve( !KU( sign(<'dpop', a, $R, 
                          h(<<'obo', H, K, Y, a, pk(x), tid>, 
                             sign(<'obo', H, K, Y, a, pk(x), tid>, ~k)>)
                         >,
                         x)
               ) @ #vk.21 )
          case Agent_sends_request
          solve( !KU( ~k.1 ) @ #vk.24 )
            case Reveal_ltk
            solve( !KU( pk(~k) ) @ #vk.23 )
              case Client_redeems_with_own_key
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma kc_witness_actor_reveal_breaks_ATTR:
  exists-trace
  "∃ R H K Y a tid #i #r.
    ((Accept( R, H, K, Y, a, tid ) @ #i) ∧ (Reveal( Y ) @ #r)) ∧
    (¬(∃ #j. Request( Y, a, tid ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y a tid #i #r.
  (Accept( R, H, K, Y, a, tid ) @ #i) ∧ (Reveal( Y ) @ #r)
 ∧
  ∀ #j. (Request( Y, a, tid ) @ #j) ⇒ ⊥"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !Ltk( $X, k.1 ) ▶₀ #r )
      case Register
      solve( !KU( sign(<'obo', H, K, $X, a, pk(x), tid>, ~k) ) @ #vk.20 )
        case c_sign
        solve( !KU( ~k ) @ #vk.22 )
          case Reveal_ltk
          solve( !KU( sign(<'dpop', a, $R, 
                            h(<<'obo', H, K, $X, a, pk(x), tid>, 
                               sign(<'obo', H, K, $X, a, pk(x), tid>, ~k)>)
                           >,
                           x)
                 ) @ #vk.22 )
            case Agent_sends_request
            solve( !KU( pk(~k) ) @ #vk.23 )
              case Client_redeems_with_own_key
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_static_task_conformant:
  exists-trace
  "∃ R H K Y a tid #i #j #k #q.
    (((((Accept( R, H, K, Y, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
       (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
      (Request( Y, a, tid ) @ #q)) ∧
     (¬(K = Y))) ∧
    (¬(∃ X #r. Reveal( X ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y a tid #i #j #k #q.
  (Accept( R, H, K, Y, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k) ∧
  (Request( Y, a, tid ) @ #q)
 ∧
  (¬(K = Y)) ∧ (∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥)"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_2
  solve( !Pk( 'AS', pk(x.2) ) ▶₁ #i )
    case Register
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( $X, kX ) ▶₂ #q )
        case Register
        solve( Intends( H, ~tid, <'fixed', op, x> ) @ #k.3 )
          case Human_consents_static
          solve( !KU( sign(<'obo', $H, K, $X, <'push', 'any'>, pk(x), ~tid>, ~k)
                 ) @ #vk.29 )
            case AS_token_endpoint
            solve( !KU( sign(<'dpop', <'push', $repo>, $R, 
                              h(<<'obo', $H, $K, $X, <'push', 'any'>, pk(x), ~tid>, 
                                 sign(<'obo', $H, $K, $X, <'push', 'any'>, pk(x), ~tid>, ~k)>)
                             >,
                             x)
                   ) @ #vk.33 )
              case Agent_sends_request
              solve( !KU( sign(<'actor', $X>, ~k.1) ) @ #vk.52 )
                case Actor_joins_flow
                solve( !KU( sign(<'join', $X, ~tid>, ~k.3) ) @ #vk.53 )
                  case Actor_joins_flow
                  solve( !KU( sign(<'dpop-tok', ~tid>, ~k) ) @ #vk.54 )
                    case Client_redeems_with_own_key
                    solve( !KU( ~tid ) @ #vk.37 )
                      case Human_consents_static
                      solve( !KU( pk(~k) ) @ #vk.37 )
                        case Client_redeems_with_own_key
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R H K Y op v S tid #i #k #l #q.
    (((((Accept( R, H, K, Y, <op, v>, tid ) @ #i) ∧
        (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
       (Produced( S, tid, v ) @ #l)) ∧
      (Request( Y, <op, v>, tid ) @ #q)) ∧
     (¬(K = Y))) ∧
    (¬(∃ X #r. Reveal( X ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H K Y op v S tid #i #k #l #q.
  (Accept( R, H, K, Y, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l) ∧
  (Request( Y, <op, v>, tid ) @ #q)
 ∧
  (¬(K = Y)) ∧ (∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥)"
*/
simplify
solve( (s = <op, $v>)  ∥
       (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (s = <op.1, 'any'>)) )
  case case_2
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !TaskOpen( tid, $Src ) ▶₀ #l )
      case Human_consents_dynamic
      solve( !Ltk( $Src, ks ) ▶₁ #l )
        case Register
        solve( !Ltk( $X, kX ) ▶₂ #q )
          case Register
          solve( Intends( H, ~tid, <'hole', op, $Src> ) @ #k.4 )
            case Human_consents_dynamic
            solve( !KU( sign(<'obo', $H, K, $X, <'push', 'any'>, pk(x), ~tid>, ~k)
                   ) @ #vk.29 )
              case AS_token_endpoint
              solve( !KU( sign(<'dpop', <'push', $v>, $R, 
                                h(<<'obo', $H, $K, $X, <'push', 'any'>, pk(x), ~tid>, 
                                   sign(<'obo', $H, $K, $X, <'push', 'any'>, pk(x), ~tid>, ~k)>)
                               >,
                               x)
                     ) @ #vk.33 )
                case Agent_sends_request
                solve( !KU( sign(<'actor', $X>, ~k.1) ) @ #vk.52 )
                  case Actor_joins_flow
                  solve( !KU( sign(<'join', $X, ~tid>, ~k.3) ) @ #vk.53 )
                    case Actor_joins_flow
                    solve( !KU( sign(<'dpop-tok', ~tid>, ~k) ) @ #vk.54 )
                      case Client_redeems_with_own_key
                      solve( !KU( ~tid ) @ #vk.37 )
                        case Human_consents_dynamic
                        solve( !KU( pk(~k) ) @ #vk.37 )
                          case Client_redeems_with_own_key
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
