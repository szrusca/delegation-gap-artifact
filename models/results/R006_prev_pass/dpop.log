lemma AUTH_nested_act_chain_was_delegated:
  all-traces
  "∀ R H A1 A2 tid #i.
    (Chain( R, H, A1, A2, tid ) @ #i) ⇒
    ((∃ c #j. (RootDelegated( H, A1, c, tid ) @ #j) ∧ (#j < #i)) ∧
     (∃ #k. (Delegated( A1, <'agent', A2>, tid ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ R H A1 A2 tid #i.
  (Chain( R, H, A1, A2, tid ) @ #i)
 ∧
  ((∀ c #j. (RootDelegated( H, A1, c, tid ) @ #j) ⇒ ¬(#j < #i)) ∨
   (∀ #k. (Delegated( A1, <'agent', A2>, tid ) @ #k) ⇒ ¬(#k < #i)))"
*/
