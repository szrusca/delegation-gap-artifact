solve( (∀ c #j. (RootDelegated( H, A1, c, tid ) @ #j) ⇒ ¬(#j < #i))  ∥
       (∀ #k. (Delegated( A1, <'agent', A2>, tid ) @ #k) ⇒ ¬(#k < #i)) )
