lemma issued_scope_within_human_consent [use_induction, reuse]:
  all-traces
  "∀ H act aud sc cnf tid #i.
    (Issued( <'at', H, act, aud, sc, cnf, tid> ) @ #i) ⇒
    (∃ A1 c #j.
      (RootDelegated( H, A1, c, tid ) @ #j) ∧
      ((c = sc) ∨ (∃ op x. (sc = <op, x>) ∧ (c = <op, 'any'>))))"
/*
guarded formula characterizing all counter-examples:
"∃ H act aud sc cnf tid #i.
  (Issued( <'at', H, act, aud, sc, cnf, tid> ) @ #i)
 ∧
  ∀ A1 c #j.
   (RootDelegated( H, A1, c, tid ) @ #j)
  ⇒
   (¬(c = sc)) ∧ (∀ op x. (sc = <op, x>) ∧ (c = <op, 'any'>) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∀ H act aud sc cnf tid #i.
           (Issued( <'at', H, act, aud, sc, cnf, tid> ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ A1 c #j.
              (RootDelegated( H, A1, c, tid ) @ #j)
             ∧
              (¬(last(#j))) ∧
              (((c = sc) ∨ (∃ op x. (sc = <op, x>) ∧ (c = <op, 'any'>)))))))  ∥
         (∃ c a #i.
           (Check( c, a ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(c = a)) ∧
           (∀ op x. (a = <op, x>) ∧ (c = <op, 'any'>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ A1 c #j.
             (RootDelegated( H, A1, c, tid ) @ #j)
            ∧
             (¬(last(#j))) ∧
             (((c = sc) ∨ (∃ op x. (sc = <op, x>) ∧ (c = <op, 'any'>))))) )
      case case_1
      solve( Issued( <'at', H, act, aud, sc, cnf, tid> ) @ #i )
        case AS_exchanges
        solve( (sc = sc.1)  ∥ (∃ op x. (sc.1 = <op, x>) ∧ (sc = <op, 'any'>)) )
          case case_1
          solve( !Pk( X, pk(x) ) ▶₁ #i )
            case Register
            solve( !Ltk( 'AS', kAS ) ▶₂ #i )
              case Register
              solve( !KU( sign(<'at', H, act, aud, sc, cnf, tid>, ~k) ) @ #vk.18 )
                case AS_exchanges
                solve( (sc.1 = sc)  ∥ (∃ op x. (sc = <op, x>) ∧ (sc.1 = <op, 'any'>)) )
                  case case_1
                  solve( (c = sc)  ∥ (∃ op x. (sc = <op, x>) ∧ (c = <op, 'any'>)) )
                    case case_1
                    by contradiction /* from formulas */
                  next
                    case case_2
                    by contradiction /* from formulas */
                  qed
                next
                  case case_2
                  solve( (c = <op, x>)  ∥
                         (∃ op.1 x.1. (<op, x> = <op.1, x.1>) ∧ (c = <op.1, 'any'>)) )
                    case case_1
                    by contradiction /* from formulas */
                  next
                    case case_2
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case Human_consents_dynamic_task
                by contradiction /* from formulas */
              next
                case Human_consents_static_task
                by contradiction /* from formulas */
              next
                case c_sign
                by solve( !KU( ~k ) @ #vk.26 )
              qed
            qed
          qed
        next
          case case_2
          solve( !Pk( X, pk(x.1) ) ▶₁ #i )
            case Register
            solve( !Ltk( 'AS', kAS ) ▶₂ #i )
              case Register
              solve( !KU( sign(<'at', H, act, aud, <op, 'any'>, cnf, tid>, ~k)
                     ) @ #vk.15 )
                case AS_exchanges
                solve( (sc = <op, 'any'>)  ∥
                       (∃ op.1 x. (<op, 'any'> = <op.1, x>) ∧ (sc = <op.1, 'any'>)) )
                  case case_1
                  solve( (c = <op, 'any'>)  ∥
                         (∃ op.1 x. (<op, 'any'> = <op.1, x>) ∧ (c = <op.1, 'any'>)) )
                    case case_1
                    by contradiction /* from formulas */
                  next
                    case case_2
                    by contradiction /* from formulas */
                  qed
                next
                  case case_2
                  solve( (c = <op, 'any'>)  ∥
                         (∃ op.1 x. (<op, 'any'> = <op.1, x>) ∧ (c = <op.1, 'any'>)) )
                    case case_1
                    by contradiction /* from formulas */
                  next
                    case case_2
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case Human_consents_dynamic_task
                by contradiction /* from formulas */
              next
                case Human_consents_static_task
                by contradiction /* from formulas */
              next
                case c_sign
                by solve( !KU( ~k ) @ #vk.30 )
              qed
            qed
          qed
        qed
      next
        case Human_consents_dynamic_task
        by contradiction /* from formulas */
      next
        case Human_consents_static_task
        by contradiction /* from formulas */
      qed
    next
      case case_2
      solve( (c = sc)  ∥ (∃ op x. (sc = <op, x>) ∧ (c = <op, 'any'>)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    solve( (c = a)  ∥ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma executable_static_task_conformant_two_hops:
  exists-trace
  "∃ R H A1 A2 a tid #i #j #k.
    ((((Accept( R, A2, a, tid ) @ #i) ∧ (Chain( R, H, A1, A2, tid ) @ #i)) ∧
      (TaskStatic( tid ) @ #j)) ∧
     (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
    (¬(A1 = A2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H A1 A2 a tid #i #j #k.
  (Accept( R, A2, a, tid ) @ #i) ∧
  (Chain( R, H, A1, A2, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  ¬(A1 = A2)"
*/
simplify
solve( (sc = a)  ∥ (∃ op x. (a = <op, x>) ∧ (sc = <op, 'any'>)) )
  case case_1
  solve( (c = <'push', 'any'>)  ∥
         (∃ op x. (<'push', 'any'> = <op, x>) ∧ (c = <op, 'any'>)) )
    case case_1
    solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
      case Register
      solve( !Ltk( $H.1, kH ) ▶₁ #j )
        case Register
        solve( !Ltk( 'AS', kAS ) ▶₂ #j )
          case Register
          solve( !Pk( $A1.1, pkA1 ) ▶₃ #j )
            case Register
            solve( Accept( $R, A2, a.1, ~tid ) @ #i )
              case Resource_accepts_depth2
              solve( Intends( H, ~tid, <'fixed', a> ) @ #k.3 )
                case Human_consents_static_task
                solve( (c = <'push', 'any'>)  ∥
                       (∃ op x. (<'push', 'any'> = <op, x>) ∧ (c = <op, 'any'>)) )
                  case case_1
                  solve( RootDelegated( $H, A1.2, <'push', 'any'>, ~tid ) @ #j.1 )
                    case Human_consents_static_task
                    solve( RootDelegated( $H, A1.4, <'push', 'any'>, ~tid ) @ #j.2 )
                      case Human_consents_static_task
                      solve( !KU( sign(<'at', $H, <'act', A2, 'act', A1, 'none'>, aud, 
                                        <'push', $repo>, pk(x), ~tid>,
                                       ~k)
                             ) @ #vk.27 )
                        case AS_exchanges
                        solve( (sc = <'push', $repo>)  ∥
                               (∃ op x. (<'push', $repo> = <op, x>) ∧ (sc = <op, 'any'>)) )
                          case case_1
                          solve( (c = <'push', $repo>)  ∥
                                 (∃ op x. (<'push', $repo> = <op, x>) ∧ (c = <op, 'any'>)) )
                            case case_2
                            solve( RootDelegated( $H, A1.2, <'push', 'any'>, ~tid ) @ #j.1 )
                              case Human_consents_static_task
                              solve( !KU( sign(<'dpop', <'push', $repo>, $R, 
                                                h(<
                                                   <'at', $H, <'act', $X, 'act', A1, 'none'>, aud, 
                                                    <'push', $repo>, pk(~k), ~tid>, 
                                                   sign(<'at', $H, <'act', $X, 'act', A1, 'none'>, aud, 
                                                         <'push', $repo>, pk(~k), ~tid>,
                                                        ~k.1)
                                                  >)
                                               >,
                                               ~k)
                                     ) @ #vk.41 )
                                case Agent_sends_request
                                solve( !KU( sign(<'at', $H, <'act', A1, 'none'>, aud.1, <'push', $repo>, 
                                                  cnf, ~tid>,
                                                 ~k.1)
                                       ) @ #vk.48 )
                                  case AS_exchanges
                                  solve( (sc = <'push', $repo>)  ∥
                                         (∃ op x. (<'push', $repo> = <op, x>) ∧ (sc = <op, 'any'>)) )
                                    case case_2
                                    solve( !KU( sign(<'xreq', $X, 
                                                      h(<
                                                         <'at', $H, <'act', $X.1, 'none'>, aud.1, 
                                                          <'push', $repo>, pk(~k.4), ~tid>, 
                                                         sign(<'at', $H, <'act', $X.1, 'none'>, aud.1, 
                                                               <'push', $repo>, pk(~k.4), ~tid>,
                                                              ~k.1)
                                                        >), 
                                                      aud, 'push', $repo>,
                                                     ~k)
                                           ) @ #vk.63 )
                                      case Agent_requests_exchange
                                      solve( !KU( sign(<'at', $H, 'none', aud.2, <'push', 'any'>, cnf, ~tid>,
                                                       ~k.1)
                                             ) @ #vk.69 )
                                        case Human_consents_static_task
                                        solve( !KU( sign(<'xreq', $X.1, 
                                                          h(<
                                                             <'at', $H, 'none', <'agent', $A1>, 
                                                              <'push', 'any'>, pk(~k.3), ~tid>, 
                                                             sign(<'at', $H, 'none', <'agent', $A1>, 
                                                                   <'push', 'any'>, pk(~k.3), ~tid>,
                                                                  ~k.1)
                                                            >), 
                                                          aud.1, 'push', $repo>,
                                                         ~k.4)
                                               ) @ #vk.71 )
                                          case Agent_requests_exchange
                                          solve( !KU( ~tid ) @ #vk.58 )
                                            case Human_consents_static_task
                                            solve( (c = <'push', 'any'>)  ∥
                                                   (∃ op x. (<'push', 'any'> = <op, x>) ∧ (c = <op, 'any'>)) )
                                              case case_1
                                              solve( RootDelegated( $H, A1.1, <'push', 'any'>, ~tid ) @ #j.1 )
                                                case Human_consents_static_task
                                                solve( !KU( pk(~k) ) @ #vk.62 )
                                                  case Register
                                                  solve( !KU( h(<
                                                                 <'at', $H, <'act', $X.1, 'none'>, aud.1, 
                                                                  <'push', $repo>, pk(~k.4), ~tid>, 
                                                                 sign(<'at', $H, <'act', $X.1, 'none'>, 
                                                                       aud.1, <'push', $repo>, pk(~k.4), ~tid
                                                                      >,
                                                                      ~k.1)
                                                                >)
                                                         ) @ #vk.69 )
                                                    case Agent_requests_exchange
                                                    solve( !KU( h(<
                                                                   <'at', $H, 'none', <'agent', $A1>, 
                                                                    <'push', 'any'>, pk(~k.3), ~tid>, 
                                                                   sign(<'at', $H, 'none', <'agent', $A1>, 
                                                                         <'push', 'any'>, pk(~k.3), ~tid>,
                                                                        ~k.1)
                                                                  >)
                                                           ) @ #vk.72 )
                                                      case Agent_requests_exchange
                                                      solve( !KU( pk(~k.4) ) @ #vk.69 )
                                                        case Register
                                                        solve( !KU( pk(~k.3) ) @ #vk.72 )
                                                          case Register
                                                          SOLVED // trace found
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant_two_hops:
  exists-trace
  "∃ R H A1 A2 op v S tid #i #k #l.
    ((((Accept( R, A2, <op, v>, tid ) @ #i) ∧
       (Chain( R, H, A1, A2, tid ) @ #i)) ∧
      (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
     (Produced( S, tid, v ) @ #l)) ∧
    (¬(A1 = A2))"
/*
guarded formula characterizing all satisfying traces:
"∃ R H A1 A2 op v S tid #i #k #l.
  (Accept( R, A2, <op, v>, tid ) @ #i) ∧
  (Chain( R, H, A1, A2, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l)
 ∧
  ¬(A1 = A2)"
*/
simplify
solve( (sc = a)  ∥ (∃ op x. (a = <op, x>) ∧ (sc = <op, 'any'>)) )
  case case_1
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !Ltk( $Src, ks ) ▶₁ #l )
      case Register
      solve( Accept( $R, A2, <op, $v>, tid ) @ #i )
        case Resource_accepts_depth2
        solve( Intends( H, tid, <'hole', op, $Src> ) @ #k.2 )
          case Human_consents_dynamic_task
          solve( (c = <'push', 'any'>)  ∥
                 (∃ op x. (<'push', 'any'> = <op, x>) ∧ (c = <op, 'any'>)) )
            case case_1
            solve( !Ltk( $H, kH ) ▶₁ #k.2 )
              case Register
              solve( !Ltk( 'AS', kAS ) ▶₂ #k.2 )
                case Register
                solve( !Pk( $A1.1, pkA1 ) ▶₃ #k.2 )
                  case Register
                  solve( RootDelegated( $H, A1.2, <'push', 'any'>, ~tid ) @ #j )
                    case Human_consents_dynamic_task
                    solve( !KU( sign(<'at', $H, <'act', A2, 'act', A1, 'none'>, aud, 
                                      <'push', $v>, pk(x), ~tid>,
                                     ~k)
                           ) @ #vk.27 )
                      case AS_exchanges
                      solve( (sc = <'push', $v>)  ∥
                             (∃ op x. (<'push', $v> = <op, x>) ∧ (sc = <op, 'any'>)) )
                        case case_1
                        solve( (c = <'push', $v>)  ∥
                               (∃ op x. (<'push', $v> = <op, x>) ∧ (c = <op, 'any'>)) )
                          case case_2
                          solve( RootDelegated( $H, A1.2, <'push', 'any'>, ~tid ) @ #j.1 )
                            case Human_consents_dynamic_task
                            solve( !KU( sign(<'dpop', <'push', $v>, $R, 
                                              h(<
                                                 <'at', $H, <'act', $X, 'act', A1, 'none'>, aud, 
                                                  <'push', $v>, pk(~k), ~tid>, 
