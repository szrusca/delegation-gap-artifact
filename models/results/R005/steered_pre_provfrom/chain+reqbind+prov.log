                              h(<<'root', H.74, A1.72, c1.76, tid.84>, 
                                 sign(<'root', H.74, A1.72, c1.76, tid.84>, x.140)>)
                             >,
                             x.138)
                       >)
                    >,
                    x.139)
       tid   = tid.84
       z     = true
       z.1   = true
       z.2   = true
  */

rule (modulo E) Resource_accept_any_provenance:
   [
   Received( R, P, <op, v>, H, A1, c1, c2, tid ),
   In( <<'prov', S, tid, v>, sp> ), !Pk( S, pkS )
   ]
  --[
  Eq( verify(sp, <'prov', S, tid, v>, pkS), true ),
  Accept( R, P, <op, v>, tid ), Chain( R, H, A1, c1, P, c2, tid )
  ]->
   [ ]

  /*
  rule (modulo AC) Resource_accept_any_provenance:
     [
     Received( R, P, <op, v>, H, A1, c1, c2, tid ),
     In( <<'prov', S, tid, v>, sp> ), !Pk( S, pkS )
     ]
    --[
    Eq( z, true ), Accept( R, P, <op, v>, tid ),
    Chain( R, H, A1, c1, P, c2, tid )
    ]->
     [ ]
    variants (modulo AC)
    1. S     = S.16
       pkS   = pkS.20
       sp    = sp.21
       tid   = tid.22
       v     = v.23
       z     = verify(sp.21, <'prov', S.16, tid.22, v.23>, pkS.20)
    
    2. S     = S.22
       pkS   = pk(x.36)
       sp    = sign(<'prov', S.22, tid.28, v.29>, x.36)
       tid   = tid.28
       v     = v.29
       z     = true
  */

lemma executable_static_task_conformant:
  exists-trace
  "∃ R P a tid H #i #j #k.
    (((Accept( R, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
     (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
    (∀ X #r. (Reveal( X ) @ #r) ⇒ (⊥))"
/*
guarded formula characterizing all satisfying traces:
"∃ R P a tid H #i #j #k.
  (Accept( R, P, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  ∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥"
*/
simplify
solve( Received( R, P, <op, v>, H, A1, c1, c2, ~tid ) ▶₀ #i )
  case Resource_receive_bound
  solve( (c1 = <op, v>)  ∥
         (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
    case case_2
    solve( (c2 = <op, v>)  ∥
           (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
      case case_1
      solve( !Pk( S, pk(x) ) ▶₂ #i )
        case Register
        solve( !Ltk( $H, kH ) ▶₁ #j )
          case Register
          solve( Intends( H.1, ~tid, <'fixed', op, v> ) @ #k.5 )
            case Human_static_task
            solve( !KU( sign(<'prov', $X.3, ~tid, $repo>, ~k) ) @ #vk.20 )
              case Source_produces
              solve( !KU( sign(<'root', $X.1, $X.2, <'push', 'any'>, ~tid>, ~k.2)
                     ) @ #vk.28 )
                case Human_static_task
                solve( !KU( sign(<'del', $A1, $X, <'push', $repo>, 
                                  h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                     sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                                 >,
                                 ~k.2)
                       ) @ #vk.33 )
                  case Agent1_steered_delegation
                  solve( !KU( sign(<'req', <'push', $repo>, $R, 
                                    h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                       sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1), 
                                       <'del', $A1, $X, <'push', $repo>, 
                                        h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                           sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                                       >, 
                                       sign(<'del', $A1, $X, <'push', $repo>, 
                                             h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                                            >,
                                            ~k.2)
                                      >)
                                   >,
                                   ~k.3)
                         ) @ #vk.36 )
                    case Agent2_steered_request
                    solve( !KU( ~tid ) @ #vk.16 )
                      case Human_static_task_case_1
                      solve( !KU( h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                     sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                             ) @ #vk.40 )
                        case Agent1_steered_delegation
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R P op v tid H S #i #j #k.
    (((Accept( R, P, <op, v>, tid ) @ #i) ∧
      (Intends( H, tid, <'hole', op, S> ) @ #j)) ∧
     (Produced( S, tid, v ) @ #k)) ∧
    (∀ X #r. (Reveal( X ) @ #r) ⇒ (⊥))"
/*
guarded formula characterizing all satisfying traces:
"∃ R P op v tid H S #i #j #k.
