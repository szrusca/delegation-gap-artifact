  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction CaveatPermits:
  "∀ c a #i.
    (Check( c, a ) @ #i) ⇒
    ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))"

  /*
  expanded formula:
  "∀ c a #i.
    (Check( c, a ) @ #i) ⇒
