    solve( (c2 = <op, $v>)  ∥
           (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
      case case_1
      solve( !Pk( S, pk(x) ) ▶₂ #i )
        case Register
        solve( !Ltk( $Src, ks ) ▶₁ #k.1 )
          case Register
          solve( Intends( H, tid, <'hole', op, $Src> ) @ #j )
            case Human_dynamic_task
            solve( !Ltk( $H, kH ) ▶₁ #j )
              case Register
              solve( !KU( sign(<'prov', $X.3, ~tid, $v>, ~k) ) @ #vk.21 )
                case Source_produces
                solve( !KU( sign(<'root', $X.1, $X.2, <'push', 'any'>, ~tid>, ~k.2)
                       ) @ #vk.28 )
                  case Human_dynamic_task
                  solve( !KU( sign(<'del', $A1, $X, <'push', $v>, 
                                    h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                       sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                                   >,
                                   ~k.2)
                         ) @ #vk.33 )
                    case Agent1_steered_delegation
                    solve( !KU( sign(<'req', <'push', $v>, $R, 
                                      h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                         sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1), 
                                         <'del', $A1, $X, <'push', $v>, 
                                          h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                             sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                                         >, 
                                         sign(<'del', $A1, $X, <'push', $v>, 
                                               h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                                  sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                                              >,
                                              ~k.2)
                                        >)
                                     >,
                                     ~k.3)
                           ) @ #vk.36 )
                      case Agent2_steered_request
                      solve( !KU( ~tid ) @ #vk.16 )
                        case Human_dynamic_task_case_1
                        solve( !KU( h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                       sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k.1)>)
                               ) @ #vk.40 )
                          case Agent1_steered_delegation
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

