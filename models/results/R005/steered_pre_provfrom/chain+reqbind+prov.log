  */

restriction ConcreteOperand:
  "∀ op #i. (Act( <op, 'any'> ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ op #i. (Act( <op, 'any'> ) @ #i) ⇒ (⊥)"
  */

restriction UniqueKey:
  "∀ X #i #j. ((Register( X ) @ #i) ∧ (Register( X ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ X #i #j. ((Register( X ) @ #i) ∧ (Register( X ) @ #j)) ⇒ (#i = #j)"
  */

