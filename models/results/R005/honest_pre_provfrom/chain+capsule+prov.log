rule (modulo E) Resource_receive_bearer:
   [
   In( <'req', a, <'root', H, A1, c1, tid>, s1, 
        <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2, sr>
   ),
   !Pk( H, pkH ), !Pk( A1, pkA1 )
   ]
  --[
  Eq( verify(s1, <'root', H, A1, c1, tid>, pkH), true ),
  Eq( verify(s2, <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>,
             pkA1),
      true
  ),
  Check( c1, a ), Check( c2, a ), Act( a )
  ]->
   [ Received( $R, A2, a, H, A1, c1, c2, tid ) ]

  /*
  rule (modulo AC) Resource_receive_bearer:
     [
     In( <'req', a, <'root', H, A1, c1, tid>, s1, 
          <'del', A1, A2, c2, h(<<'root', H, A1, c1, tid>, s1>)>, s2, sr>
     ),
     !Pk( H, pkH ), !Pk( A1, pkA1 )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Check( c1, a ), Check( c2, a ), Act( a )
    ]->
     [ Received( $R, A2, a, H, A1, c1, c2, tid ) ]
    variants (modulo AC)
    1. A1    = A1.31
       A2    = A2.32
       H     = H.33
       c1    = c1.35
       c2    = c2.36
       pkA1  = pkA1.37
       pkH   = pkH.38
       s1    = s1.39
       s2    = s2.40
       tid   = tid.42
       z     = verify(s1.39, <'root', H.33, A1.31, c1.35, tid.42>, pkH.38)
       z.1   = verify(s2.40,
                      <'del', A1.31, A2.32, c2.36, 
                       h(<<'root', H.33, A1.31, c1.35, tid.42>, s1.39>)>,
                      pkA1.37)
    
    2. A1    = A1.60
       A2    = A2.61
       H     = H.62
       c1    = c1.64
       c2    = c2.65
       pkA1  = pk(x.117)
       pkH   = pkH.67
       s1    = s1.68
       s2    = sign(<'del', A1.60, A2.61, c2.65, 
                     h(<<'root', H.62, A1.60, c1.64, tid.71>, s1.68>)>,
                    x.117)
       tid   = tid.71
       z     = verify(s1.68, <'root', H.62, A1.60, c1.64, tid.71>, pkH.67)
       z.1   = true
    
    3. A1    = A1.61
       A2    = A2.62
       H     = H.63
       c1    = c1.65
       c2    = c2.66
       pkA1  = pkA1.67
       pkH   = pk(x.119)
       s1    = sign(<'root', H.63, A1.61, c1.65, tid.72>, x.119)
       s2    = s2.70
       tid   = tid.72
       z     = true
       z.1   = verify(s2.70,
                      <'del', A1.61, A2.62, c2.66, 
                       h(<<'root', H.63, A1.61, c1.65, tid.72>, 
                          sign(<'root', H.63, A1.61, c1.65, tid.72>, x.119)>)
                      >,
                      pkA1.67)
    
    4. A1    = A1.61
       A2    = A2.62
       H     = H.63
       c1    = c1.65
       c2    = c2.66
       pkA1  = pk(x.118)
       pkH   = pk(x.119)
       s1    = sign(<'root', H.63, A1.61, c1.65, tid.72>, x.119)
       s2    = sign(<'del', A1.61, A2.62, c2.66, 
                     h(<<'root', H.63, A1.61, c1.65, tid.72>, 
                        sign(<'root', H.63, A1.61, c1.65, tid.72>, x.119)>)
                    >,
                    x.118)
       tid   = tid.72
       z     = true
       z.1   = true
  */

rule (modulo E) Resource_accept_capsule_fixed:
   [
   Received( R, P, <op, v>, H, A1, c1, c2, tid ),
   In( <<'cap', H, tid, 'fixed', op, v>, sc> ), !Pk( H, pkH )
   ]
  --[
  Eq( verify(sc, <'cap', H, tid, 'fixed', op, v>, pkH), true ),
  Accept( R, P, <op, v>, tid ), Chain( R, H, A1, c1, P, c2, tid )
  ]->
   [ ]

  /*
  rule (modulo AC) Resource_accept_capsule_fixed:
     [
     Received( R, P, <op, v>, H, A1, c1, c2, tid ),
     In( <<'cap', H, tid, 'fixed', op, v>, sc> ), !Pk( H, pkH )
     ]
    --[
    Eq( z, true ), Accept( R, P, <op, v>, tid ),
    Chain( R, H, A1, c1, P, c2, tid )
    ]->
     [ ]
    variants (modulo AC)
    1. H     = H.25
       op    = op.30
       pkH   = pkH.31
       sc    = sc.32
       tid   = tid.33
       v     = v.34
       z     = verify(sc.32, <'cap', H.25, tid.33, 'fixed', op.30, v.34>,
                      pkH.31)
    
    2. H     = H.35
       op    = op.40
       pkH   = pk(x.67)
       sc    = sign(<'cap', H.35, tid.43, 'fixed', op.40, v.44>, x.67)
       tid   = tid.43
       v     = v.44
       z     = true
  */

