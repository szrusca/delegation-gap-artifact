lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R P op v tid H S #i #j #k.
    (((Accept( R, P, <op, v>, tid ) @ #i) ∧
      (Intends( H, tid, <'hole', op, S> ) @ #j)) ∧
     (Produced( S, tid, v ) @ #k)) ∧
    (∀ X #r. (Reveal( X ) @ #r) ⇒ (⊥))"
/*
guarded formula characterizing all satisfying traces:
"∃ R P op v tid H S #i #j #k.
  (Accept( R, P, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #j) ∧
  (Produced( S, tid, v ) @ #k)
 ∧
  ∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥"
*/
simplify
solve( !Ltk( $Src, ks ) ▶₁ #k )
  case Register
  solve( Accept( R, P, <op, $v>, tid ) @ #i )
    case Resource_accept_capsule_hole_provenance
    solve( Received( R, P, <op, $v>, H, A1, c1, c2, tid ) ▶₀ #i )
      case Resource_receive_bearer
      solve( (c1 = <op, $v>)  ∥
             (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
        case case_2
        solve( (c2 = <op, $v>)  ∥
               (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
          case case_2
          solve( !Pk( $X, pk(x) ) ▶₃ #i )
            case Register
            solve( !Pk( S, pk(x) ) ▶₄ #i )
              case Register
              solve( Intends( H, tid, <'hole', op, $Src> ) @ #j )
                case Human_dynamic_task
                solve( !Ltk( $H, kH ) ▶₁ #j )
                  case Register
                  solve( !KU( sign(<'cap', $X, ~tid, 'hole', 'push', $X.2>, ~k)
                         ) @ #vk.30 )
                    case Human_dynamic_task
                    solve( !KU( sign(<'root', $H, $X, <'push', 'any'>, ~tid>, ~k)
                           ) @ #vk.38 )
                      case Human_dynamic_task
                      solve( !KU( sign(<'del', $A1, P, <'push', 'any'>, 
                                        h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                           sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                       >,
                                       ~k.2)
                             ) @ #vk.43 )
                        case Agent1_honest_delegation
                        solve( !KU( ~tid ) @ #vk.6 )
                          case Human_dynamic_task_case_1
                          solve( !KU( sign(<'prov', $Src, ~tid, $v>, ~k.1) ) @ #vk.38 )
                            case Source_produces
                            solve( !KU( h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                           sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                   ) @ #vk.44 )
                              case Agent1_honest_delegation
                              SOLVED // trace found
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

