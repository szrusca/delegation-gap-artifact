   [
   Received( R, P, <op, v>, H, A1, c1, c2, tid ),
   In( <<'cap', H, tid, 'hole', op, S>, sc> ),
   In( <<'prov', S, tid, v>, sp> ), !Pk( H, pkH ), !Pk( S, pkS )
   ]
