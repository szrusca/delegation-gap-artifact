       z.1   = verify(sp.74, <'prov', S.67, tid.75, v.76>, pkS.72)
    
    4. H     = H.65
       S     = S.68
       op    = op.71
       pkH   = pk(x.126)
       pkS   = pk(x.127)
       sc    = sign(<'cap', H.65, tid.76, 'hole', op.71, S.68>, x.126)
       sp    = sign(<'prov', S.68, tid.76, v.77>, x.127)
       tid   = tid.76
       v     = v.77
       z     = true
       z.1   = true
  */

lemma executable_static_task_conformant:
  exists-trace
  "∃ R P a tid H #i #j #k.
    (((Accept( R, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
     (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
    (∀ X #r. (Reveal( X ) @ #r) ⇒ (⊥))"
/*
guarded formula characterizing all satisfying traces:
"∃ R P a tid H #i #j #k.
  (Accept( R, P, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  ∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥"
*/
simplify
solve( !Ltk( $H, kH ) ▶₁ #j )
  case Register
  solve( Accept( R, P, a, ~tid ) @ #i )
    case Resource_accept_capsule_fixed
    solve( Received( R, P, <op, v>, H, A1, c1, c2, ~tid ) ▶₀ #i )
      case Resource_receive_bearer
      solve( (c1 = <op, v>)  ∥
             (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
        case case_2
        solve( (c2 = <op, v>)  ∥
               (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
          case case_2
          solve( !Pk( $X, pk(x) ) ▶₂ #i )
            case Register
            solve( Intends( H.1, ~tid, <'fixed', op, v> ) @ #k.4 )
              case Human_static_task
              solve( !KU( sign(<'cap', $X, ~tid, 'fixed', 'push', $repo>, ~k)
                     ) @ #vk.23 )
                case Human_static_task
                solve( !KU( sign(<'root', $H, $X, <'push', 'any'>, ~tid>, ~k)
                       ) @ #vk.30 )
                  case Human_static_task
                  solve( !KU( sign(<'del', $A1, P, <'push', 'any'>, 
                                    h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                       sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                   >,
                                   ~k.1)
                         ) @ #vk.35 )
                    case Agent1_honest_delegation
                    solve( !KU( ~tid ) @ #vk.16 )
                      case Human_static_task_case_1
                      solve( !KU( h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                     sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                             ) @ #vk.36 )
                        case Agent1_honest_delegation
                        SOLVED // trace found
                      qed
