lemma executable_static_task_conformant:
  exists-trace
  "∃ R P a tid H #i #j #k.
    (((Accept( R, P, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
     (Intends( H, tid, <'fixed', a> ) @ #k)) ∧
    (∀ X #r. (Reveal( X ) @ #r) ⇒ (⊥))"
/*
guarded formula characterizing all satisfying traces:
"∃ R P a tid H #i #j #k.
  (Accept( R, P, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)
 ∧
  ∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥"
*/
simplify
solve( !Ltk( $H, kH ) ▶₁ #j )
  case Register
  solve( Accept( R, P, a, ~tid ) @ #i )
    case Resource_accept_capsule_fixed
    solve( Received( R, P, <op, v>, H, A1, c1, c2, ~tid ) ▶₀ #i )
      case Resource_receive_bearer
      solve( (c1 = <op, v>)  ∥
             (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
        case case_2
        solve( (c2 = <op, v>)  ∥
               (∃ op.1 x. (<op, v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
          case case_1
          solve( !Pk( $X, pk(x) ) ▶₂ #i )
            case Register
            solve( Intends( H.1, ~tid, <'fixed', op, v> ) @ #k.4 )
              case Human_static_task
              solve( !KU( sign(<'cap', $X, ~tid, 'fixed', 'push', $repo>, ~k)
                     ) @ #vk.23 )
                case Human_static_task
                solve( !KU( sign(<'root', $H, $X, <'push', 'any'>, ~tid>, ~k)
                       ) @ #vk.30 )
                  case Human_static_task
                  solve( !KU( sign(<'del', $A1, P, <'push', $repo>, 
                                    h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                       sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                                   >,
                                   ~k.1)
                         ) @ #vk.35 )
                    case Agent1_steered_delegation
                    solve( !KU( ~tid ) @ #vk.16 )
                      case Human_static_task_case_1
                      solve( !KU( h(<<'root', $H, $A1, <'push', 'any'>, ~tid>, 
                                     sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, ~k)>)
                             ) @ #vk.37 )
                        case Agent1_steered_delegation
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R P op v tid H S #i #j #k.
    (((Accept( R, P, <op, v>, tid ) @ #i) ∧
      (Intends( H, tid, <'hole', op, S> ) @ #j)) ∧
     (Produced( S, tid, v ) @ #k)) ∧
    (∀ X #r. (Reveal( X ) @ #r) ⇒ (⊥))"
/*
guarded formula characterizing all satisfying traces:
"∃ R P op v tid H S #i #j #k.
  (Accept( R, P, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #j) ∧
  (Produced( S, tid, v ) @ #k)
 ∧
  ∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥"
*/
simplify
solve( !Ltk( $Src, ks ) ▶₁ #k )
  case Register
  solve( Accept( R, P, <op, $v>, tid ) @ #i )
    case Resource_accept_capsule_hole_unchecked
    solve( Received( R, P, <op, $v>, H, A1, c1, c2, tid ) ▶₀ #i )
      case Resource_receive_bearer
      solve( (c1 = <op, $v>)  ∥
             (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c1 = <op.1, 'any'>)) )
        case case_2
        solve( (c2 = <op, $v>)  ∥
               (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (c2 = <op.1, 'any'>)) )
          case case_1
          solve( !Pk( $X, pk(x) ) ▶₂ #i )
            case Register
            solve( Intends( H, tid, <'hole', op, $Src> ) @ #j )
              case Human_dynamic_task
