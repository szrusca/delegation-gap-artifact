theory AbsChain

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction CaveatPermits:
  "∀ c a #i.
    (Check( c, a ) @ #i) ⇒
    ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))"

  /*
  expanded formula:
  "∀ c a #i.
    (Check( c, a ) @ #i) ⇒
    ((c = a) ∨ (∃ op x. (a = <op, x>) ∧ (c = <op, 'any'>)))"
  */

restriction ConcreteOperand:
  "∀ op #i. (Act( <op, 'any'> ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ op #i. (Act( <op, 'any'> ) @ #i) ⇒ (⊥)"
  */

restriction UniqueKey:
  "∀ X #i #j. ((Register( X ) @ #i) ∧ (Register( X ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ X #i #j. ((Register( X ) @ #i) ∧ (Register( X ) @ #j)) ⇒ (#i = #j)"
  */

restriction OneValuePerSourceAndTask:
  "∀ s t v w #i #j.
    ((Produced( s, t, v ) @ #i) ∧ (Produced( s, t, w ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ s t v w #i #j.
    ((Produced( s, t, v ) @ #i) ∧ (Produced( s, t, w ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Register:
   [ Fr( ~k ) ]
  --[ Register( $X ) ]->
   [ !Ltk( $X, ~k ), !Pk( $X, pk(~k) ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal:
   [ !Ltk( $X, k ) ] --[ Reveal( $X ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

restriction OnlyAgentKeysRevealed:
  "∀ X #r.
    (Reveal( X ) @ #r) ⇒
    ((¬(∃ Y c t #j. RootDelegated( X, Y, c, t ) @ #j)) ∧
     (¬(∃ t v #j. Produced( X, t, v ) @ #j)))"
  // safety formula

  /*
  expanded formula:
  "∀ X #r.
    (Reveal( X ) @ #r) ⇒
    ((¬(∃ Y c t #j. RootDelegated( X, Y, c, t ) @ #j)) ∧
     (¬(∃ t v #j. Produced( X, t, v ) @ #j)))"
  */

rule (modulo E) Human_static_task:
   [ Fr( ~tid ), !Ltk( $H, kH ) ]
  --[
  Intends( $H, ~tid, <'fixed', 'push', $repo> ),
  RootDelegated( $H, $A1, <'push', 'any'>, ~tid ), TaskStatic( ~tid )
  ]->
   [
   Out( <<'root', $H, $A1, <'push', 'any'>, ~tid>, 
         sign(<'root', $H, $A1, <'push', 'any'>, ~tid>, kH)>
   ),
   Out( <<'cap', $H, ~tid, 'fixed', 'push', $repo>, 
         sign(<'cap', $H, ~tid, 'fixed', 'push', $repo>, kH)>
   )
   ]

  /* has exactly the trivial AC variant */

