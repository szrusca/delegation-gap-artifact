        solve( Intends( $H, ~tid, <'hole', op, $Src> ) @ #k.4 )
          case Human_consents_dynamic
          solve( !KU( sign(<'at', $H, C, $M, <'push', $v>, cnf, ~tid>, ~k.1)
                 ) @ #vk.21 )
            case Human_consents_dynamic
            solve( !KU( ~tid ) @ #vk.20 )
              case Human_consents_dynamic
