lemma executable_static_task_conformant:
  exists-trace
  "∃ R H L a tid #i #j #k.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (TaskStatic( tid ) @ #j)) ∧
    (Intends( H, tid, <'fixed', a> ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L a tid #i #j #k.
  (Accept( R, H, L, a, tid ) @ #i) ∧
  (TaskStatic( tid ) @ #j) ∧
  (Intends( H, tid, <'fixed', a> ) @ #k)"
*/
simplify
solve( UpReq( M, R, H, L, a, ~tid ) ▶₀ #i )
  case Server_executes_tool_call
  solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
    case case_2
    solve( !Ltk( $H.1, kH ) ▶₁ #j )
      case Register
      solve( !Ltk( 'AS', kAS ) ▶₂ #j )
        case Register
        solve( !Pk( $C, pkC ) ▶₃ #j )
          case Register
          solve( Intends( $H, ~tid, <'fixed', op, x> ) @ #k.4 )
            case Human_consents_static
            solve( !KU( sign(<'at', $H, L, $M, <'push', 'any'>, pk(x), ~tid>, ~k.1)
                   ) @ #vk.22 )
              case Human_consents_static
              solve( !KU( sign(<'dpop', <'push', $repo>, $M, 
                                h(<<'at', $H, $C, $M, <'push', 'any'>, pk(~k.2), ~tid>, 
                                   sign(<'at', $H, $C, $M, <'push', 'any'>, pk(~k.2), ~tid>, ~k.1)>)
                               >,
                               ~k.2)
                     ) @ #vk.23 )
                case Agent_calls_tool
                solve( !KU( ~tid ) @ #vk.26 )
                  case Human_consents_static
                  solve( !KU( pk(~k.2) ) @ #vk.26 )
                    case Human_consents_dynamic
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_dynamic_task_conformant:
  exists-trace
  "∃ R H L op v S tid #i #k #l.
    ((Accept( R, H, L, <op, v>, tid ) @ #i) ∧
     (Intends( H, tid, <'hole', op, S> ) @ #k)) ∧
    (Produced( S, tid, v ) @ #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ R H L op v S tid #i #k #l.
  (Accept( R, H, L, <op, v>, tid ) @ #i) ∧
  (Intends( H, tid, <'hole', op, S> ) @ #k) ∧
  (Produced( S, tid, v ) @ #l)"
*/
simplify
solve( UpReq( M, R, H, L, <op, $v>, tid ) ▶₀ #i )
  case Server_executes_tool_call
  solve( (s = <op, $v>)  ∥
         (∃ op.1 x. (<op, $v> = <op.1, x>) ∧ (s = <op.1, 'any'>)) )
    case case_2
    solve( !TaskOpen( tid, $Src ) ▶₀ #l )
      case Human_consents_dynamic
      solve( !Ltk( $Src, ks ) ▶₁ #l )
        case Register
        solve( Intends( $H, ~tid, <'hole', op, $Src> ) @ #k.5 )
          case Human_consents_dynamic
          solve( !KU( sign(<'at', $H, L, $M, <'push', 'any'>, pk(x), ~tid>, ~k.1)
                 ) @ #vk.22 )
            case Human_consents_dynamic
            solve( !KU( sign(<'dpop', <'push', $v>, $M, 
                              h(<<'at', $H, $C, $M, <'push', 'any'>, pk(~k.1), ~tid>, 
                                 sign(<'at', $H, $C, $M, <'push', 'any'>, pk(~k.1), ~tid>, ~k.2)>)
                             >,
                             ~k.1)
                   ) @ #vk.23 )
              case Agent_calls_tool
              solve( !KU( ~tid ) @ #vk.26 )
                case Human_consents_dynamic
                solve( !KU( pk(~k.1) ) @ #vk.26 )
                  case Human_consents_dynamic
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

