lemma CONSENT_M_server_acts_only_on_its_own_grant:
  all-traces
  "∀ M H C a tid #i.
    (ToolExec( M, H, C, a, tid ) @ #i) ⇒
    (∃ s #j. Consent( H, C, M, s, tid ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ M H C a tid #i.
  (ToolExec( M, H, C, a, tid ) @ #i)
 ∧
  ∀ s #j. (Consent( H, C, M, s, tid ) @ #j) ⇒ ⊥"
*/
simplify
solve( (s = a)  ∥ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>)) )
  case case_1
  solve( !Pk( 'AS', pk(x.1) ) ▶₁ #i )
    case Register
    solve( !UpTok( $M, H, $R ) ▶₂ #i )
      case Human_authorizes_server_upstream
      solve( !KU( sign(<'at', $H, C, $M, a, pk(x), tid>, ~k) ) @ #vk.21 )
        case Human_consents_dynamic
        by contradiction /* from formulas */
      next
        case Human_consents_other
        by contradiction /* from formulas */
      next
        case Human_consents_static
        by contradiction /* from formulas */
      next
        case c_sign
        by solve( !KU( ~k ) @ #vk.23 )
      qed
    qed
  qed
next
  case case_2
  solve( !Pk( 'AS', pk(x.2) ) ▶₁ #i )
    case Register
    solve( !UpTok( $M, H, $R ) ▶₂ #i )
      case Human_authorizes_server_upstream
      solve( !KU( sign(<'at', $H, C, $M, <op, 'any'>, pk(x.1), tid>, ~k)
             ) @ #vk.22 )
        case Human_consents_dynamic
        by contradiction /* from formulas */
      next
        case Human_consents_other
        by contradiction /* from formulas */
      next
        case Human_consents_static
        by contradiction /* from formulas */
      next
        case c_sign
        by solve( !KU( ~k ) @ #vk.27 )
      qed
    qed
  qed
qed

lemma NOESC_upstream_action_within_consent_at_server:
  all-traces
  "∀ R M H L a tid #i.
    ((Accept( R, H, L, a, tid ) @ #i) ∧ (ViaServer( R, M, a, tid ) @ #i)) ⇒
    (∃ C s #j.
      (Consent( H, C, M, s, tid ) @ #j) ∧
      ((s = a) ∨ (∃ op x. (a = <op, x>) ∧ (s = <op, 'any'>))))"
/*
guarded formula characterizing all counter-examples:
"∃ R M H L a tid #i.
  (Accept( R, H, L, a, tid ) @ #i) ∧ (ViaServer( R, M, a, tid ) @ #i)
 ∧
  ∀ C s #j.
